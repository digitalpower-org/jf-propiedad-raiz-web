{
  "name": "jf-propiedad-raiz-web",
  "version": "1.0.0",
  "private": true,
  "description": "Plataforma web inmobiliaria para JF Propiedad Raíz (Valle de Aburrá). Next.js + Firebase + Cloudflare R2.",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": "24.22.1"
  },
  "scripts": {
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspaces --if-present",
    "lhci": "lhci autorun",
    "analyze:bundle": "node scripts/analyze-bundle.mjs",
    "emulators": "firebase emulators:start --project=jf-propiedad-raiz --import=/home/daniel/.firebase/emulators/firestore-data --export-on-exit=/home/daniel/.firebase/emulators/firestore-data",
    "emulators:clean": "rm -rf /home/daniel/.firebase/emulators/firestore-data && firebase emulators:start --project=jf-propiedad-raiz",
    "emulators:only": "firebase emulators:start --only auth,firestore,functions,apphosting --project=jf-propiedad-raiz",
    "emulators:be": "firebase emulators:start --only auth,firestore,functions --project=jf-propiedad-raiz",
    "r2:up": "docker compose -f ${R2_COMPOSE_FILE:-../../docker-services/minio/docker-compose.yml} up -d",
    "r2:down": "docker compose -f ${R2_COMPOSE_FILE:-../../docker-services/minio/docker-compose.yml} down",
    "r2:init": "bash scripts/r2-init.sh",
    "seed:admins": "FIRESTORE_EMULATOR_HOST=localhost:8080 node firestore-seed.js"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=10.0.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.0",
    "prettier": "^3.0.0"
  },
  "packageManager": "npm@11.19.0"
}
