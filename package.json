{
  "name": "jf-propiedad-raiz-web",
  "version": "1.0.0",
  "private": true,
  "description": "Plataforma web inmobiliaria para JF Propiedad Raíz (Valle de Aburrá). Next.js + Firebase + Cloudflare R2.",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": "24"
  },
  "scripts": {
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspaces --if-present",
    "lhci": "lhci autorun",
    "analyze:bundle": "node scripts/analyze-bundle.mjs"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "^11.19.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.0",
    "prettier": "^3.0.0"
  },
  "packageManager": "npm@11.19.0"
}
