{
  "ci": {
    "collect": {
      "startServerCommand": "npm run start -w @jf/client",
      "startServerReadyPattern": "Ready in",
      "startServerReadyTimeout": 30000,
      "url": [
        "http://localhost:3000/es",
        "http://localhost:3000/en",
        "http://localhost:3000/es/venta",
        "http://localhost:3000/en/sale",
        "http://localhost:3000/es/alquiler",
        "http://localhost:3000/en/rent",
        "http://localhost:3000/es/proyectos",
        "http://localhost:3000/en/projects",
        "http://localhost:3000/es/servicios",
        "http://localhost:3000/en/services",
        "http://localhost:3000/es/nosotros",
        "http://localhost:3000/en/about-us",
        "http://localhost:3000/es/contacto",
        "http://localhost:3000/en/contact",
        "http://localhost:3000/es/aviso-de-privacidad",
        "http://localhost:3000/en/privacy-notice",
        "http://localhost:3000/es/politica-de-tratamiento-de-datos",
        "http://localhost:3000/en/data-processing-policy",
        "http://localhost:3000/es/terminos",
        "http://localhost:3000/en/terms"
      ],
      "numberOfRuns": 1
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.85 }],
        "largest-contentful-paint": ["warn", { "maxNumericValue": 2500 }],
        "cumulative-layout-shift": ["warn", { "maxNumericValue": 0.1 }],
        "total-blocking-time": ["warn", { "maxNumericValue": 300 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
