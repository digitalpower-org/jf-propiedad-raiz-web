{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": false,
    "types": [
      "node",
      "json-schema",
      "json5",
      "long",
      "ms",
      "qs",
      "range-parser",
      "yauzl"
    ],
    "noEmit": true
  },
  "include": ["src/**/*.d.ts"]
}