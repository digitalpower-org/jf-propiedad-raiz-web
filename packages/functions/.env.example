# Functions — variables de entorno para desarrollo local.
# Copia este archivo a `.env` en packages/functions/ y rellena los valores.
# `.env` está en .gitignore; este ejemplo no contiene secretos reales.

# Debe coincidir exactamente con BFF_INTERNAL_KEY de packages/client/.env.local
BFF_INTERNAL_KEY=cambia-esto-por-una-clave-de-32-o-mas-caracteres

# Traductor falso para desarrollo (AC0.5.9). Sin credenciales de Google.
TRANSLATOR_FAKE=1
# TRANSLATOR_FAKE_MODE=error   # simula fallos de traducción (Fase 5)

# R2 local (pgsty/silo). Ver scripts/r2-init.sh y docs/EMULATORS.md
R2_ENDPOINT=http://127.0.0.1:9000
R2_REGION=auto
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadmin
R2_BUCKET=jf-media
R2_PUBLIC_BASE_URL=http://127.0.0.1:9000/jf-media

# Inyectadas por el emulador de Functions; se documentan para referencia:
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
