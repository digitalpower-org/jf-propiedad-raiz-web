# Functions — variables de entorno para desarrollo local.
# Copia este archivo a `.env` en packages/functions/ y rellena los valores.
# `.env` está en .gitignore; este ejemplo no contiene secretos reales.

# Debe coincidir exactamente con BFF_INTERNAL_KEY de packages/client/.env.local
BFF_INTERNAL_KEY=cambia-esto-por-una-clave-de-32-o-mas-caracteres

# URL pública del BFF (opcional, default: http://127.0.0.1:3000)
BFF_URL=https://bff.jfpropiedadraiz.com

# Proyecto de Firebase (opcional, default: jf-propiedad-raiz)
NEXT_PUBLIC_FIREBASE_PROJECT_ID=jf-propiedad-raiz

# Traductor falso para desarrollo (AC0.5.9). Sin credenciales de Google.
TRANSLATOR_FAKE=1
# TRANSLATOR_FAKE_MODE=error   # simula fallos de traducción (Fase 5)

# Resend — envío de correos de consignación (US3.2)
RESEND_API_KEY=re_tu_api_key_de_resend
RESEND_FROM_EMAIL=consignaciones@jfpropiedadraiz.com

# Resend — secreto de firma del webhook de entrega (no es un secreto real)
RESEND_WEBHOOK_SECRET=tu_secreto_de_webhook_de_resend_ejemplo

# TTL de notificaciones de consignación en segundos (opcional, default: 86400 = 24 h)
CONSIGNMENT_NOTIFICATION_TTL_SECONDS=86400

# Destinatario de correos de consignación (opcional, default: juanfer@jfpropiedadraiz.com)
CONSIGNMENT_TO_EMAIL=tu-email@ejemplo.com

# R2 local (pgsty/silo). Ver scripts/r2-init.sh y docs/EMULATORS.md
R2_ENDPOINT=http://127.0.0.1:9000
R2_REGION=auto
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadmin
R2_BUCKET=jf-media
R2_PUBLIC_BASE_URL=http://127.0.0.1:9000/jf-media

# Inyectadas por el emulador de Functions; se documentan para referencia:
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
