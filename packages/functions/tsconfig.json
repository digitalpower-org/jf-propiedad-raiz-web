{
  "compilerOptions": {
    "module": "NodeNext",
    "esModuleInterop": true,
    "moduleResolution": "nodenext",
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "outDir": "lib",
    "rootDir": "src",
    "sourceMap": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "target": "es2017",
    "skipLibCheck": true,
    "paths": {
      "@jf/shared-types": ["../shared-types/src/index"]
    }
  },
  "compileOnSave": true,
  "include": ["src"]
}
