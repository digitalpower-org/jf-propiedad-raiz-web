rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ================================================================
    // DENY por defecto — todo lo no explícitamente permitido está cerrado
    // ================================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ================================================================
    // Colección: authorized_users (lista blanca de administradores)
    // Nota: el Admin SDK (firestore-seed.js) omite reglas por completo.
    //       Aquí solo se controla el acceso desde el SDK cliente (emulador).
    // ================================================================
    match /authorized_users/{docId} {
      // Solo Admin SDK: la lista blanca no se lee ni se escribe desde el cliente
      allow read, write: if false;
    }

    // ================================================================
    // Colección: properties (catálogo de inmuebles)
    // ================================================================
    match /properties/{propertyId} {
      // Lectura pública: solo inmuebles con status ACTIVE (catálogo público)
      allow read: if resource.data.status == 'ACTIVE';
      // Escritura solo por Admin SDK/BFF (el cliente no escribe)
      allow write: if false;
    }

    // ================================================================
    // Colección: services (servicios del CMS)
    // ================================================================
    match /services/{serviceId} {
      // Lectura pública: solo servicios con status ACTIVE
      allow read: if resource.data.status == 'ACTIVE';
      // Escritura solo por Admin SDK/BFF (el cliente no escribe)
      allow write: if false;
    }

    // ================================================================
    // Documento único: pages/nosotros
    // ================================================================
    match /pages/{pageId} {
      // Lectura pública solo del documento nosotros
      allow read: if pageId == 'nosotros';
      // Escritura solo por Admin SDK/BFF (el cliente no escribe)
      allow write: if false;
    }

  }
}
