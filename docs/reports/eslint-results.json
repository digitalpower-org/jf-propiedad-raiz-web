Do not use `window.location.href` to navigate to internal Next.js pages. Use `redirect()` in the render phase, or `useRouter().push()` in Client Components' event handlers instead. See: https://nextjs.org/docs/messages/no-location-assign-relative-destination","line":10,"column":9,"nodeType":"AssignmentExpression","messageId":"noLocationAssign","endLine":10,"endColumn":49}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"'use client';\nimport { useState } from 'react';\n\nexport function LogoutButton() {\n  const [done, setDone] = useState(false);\n  return (\n    <button\n      onClick={async () => {\n        await fetch('/api/auth/logout', { method: 'POST' });\n        window.location.href = '/es/admin/login';\n      }}\n      style={{\n        padding: '8px 16px',\n        cursor: 'pointer',\n        background: '#dc2626',\n        color: '#fff',\n        border: 'none',\n        borderRadius: '4px',\n      }}\n    >\n      {done ? 'Cerrado' : 'Cerrar sesión (logout)'}\n    </button>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/home/diego/Documentos/jf-propiedad-raiz-web/packages/client/src/app/[locale]/admin/(protected)/layout.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/home/diego/Documentos/jf-propiedad-raiz-web/packages/client/src/app/[locale]/admin/(protected)/page.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'notFound' is defined but never used.","line":1,"column":10,"nodeType":"Identifier","messageId":"unusedVar","endLine":1,"endColumn":18,"suggestions":[{"messageId":"removeUnusedImportDeclaration","data":{"varName":"notFound"},"fix":{"range":[0,44],"text":""},"desc":"Remove unused import declaration."}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { notFound } from 'next/navigation';\nimport { cookies } from 'next/headers';\nimport { verifySession } from '@/server/session/jwt';\nimport { LogoutButton } from './LogoutButton';\n\nimport styles from './page.module.css';\n\nexport default async function AdminPage() {\n  const cookieStore = await cookies();\n  const cookieVal = cookieStore.get('__session')?.value;\n  let claims = null;\n  if (cookieVal) {\n    try {\n      claims = verifySession(cookieVal);\n    } catch {\n      claims = null;\n    }\n  }\n  return (\n    <div className={styles.page}>\n      <div className={styles.content}>\n        <header className={styles.header}>\n          <h1 className={styles.title}>Panel de Administración</h1>\n          <p className={styles.subtitle}>\n            {claims\n              ? 'Sesión activa'\n              : 'No se pudo verificar la cookie de sesión'}\n          </p>\n        </header>\n\n        {claims ? (\n          <div className={styles.sessionCard}>\n            <div className={styles.sessionRow}>\n              <span className={styles.sessionLabel}>Usuario:</span>\n              <span className={styles.sessionValue}>{claims.email}</span>\n            </div>\n            <div className={styles.sessionRow}>\n              <span className={styles.sessionLabel}>Rol:</span>\n              <span className={styles.sessionValue}>{claims.role}</span>\n            </div>\n            <div className={styles.sessionRow}>\n              <span className={styles.sessionLabel}>UID:</span>\n              <span className={styles.sessionValue}>{claims.sub}</span>\n            </div>\n          </div>\n        ) : (\n          <div className={styles.errorBox}>\n            <p className={styles.errorText}>\n              No se pudo verificar la cookie de sesión.\n            </p>\n          </div>\n        )}\n\n        <div className={styles.logoutContainer}>\n          <LogoutButton />\n        </div>\n\n        <div className={styles.infoBox}>\n          <p className={styles.infoText}>\n            Ruta protegida. Solo accesible con cookie <code>__session</code> válida.\n          </p>\n        </div>\n      </div>\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/home/diego/Documentos/jf-propiedad-raiz-web/packages/client/src/app/[locale]/admin/layout.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/home/diego/Documentos/jf-propiedad-raiz-web/packages/client/src/app/[locale]/admin/login/page.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/home/diego/Documentos/jf-propiedad-raiz-web/packages/client/src/app/[locale]/admin/whoami/page.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/home/diego/Documentos/jf-propiedad-raiz-web/packages/client/src/app/[locale]/alquiler/page.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/home/diego/Documentos/jf-propiedad-raiz-web/packages/client/src/app/[locale]/aviso-de-privacidad/page.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/home/diego/Documentos/jf-propiedad-raiz-web/packages/client/src/app/[locale]/consigne-su-propiedad/page.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/home/diego/Documentos/jf-propiedad-raiz-web/packages/client/src/app/[locale]/contacto/page.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/home/diego/Documentos/jf-propiedad-raiz-web/packages/client/src/app/[locale]/layout.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'Locale' is defined but never used.","line":12,"column":34,"nodeType":"Identifier","messageId":"unusedVar","endLine":12,"endColumn":40,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"Locale"},"fix":{"range":[513,526],"text":""},"desc":"Remove unused variable \"Locale\"."}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import type { Metadata } from 'next';\nimport type { ReactNode } from 'react';\nimport { notFound } from 'next/navigation';\nimport { NextIntlClientProvider } from 'next-intl';\nimport { getTranslations, setRequestLocale } from 'next-intl/server';\nimport { Plus_Jakarta_Sans } from 'next/font/google';\nimport '@mantine/core/styles.css';\nimport { ColorSchemeScript, MantineProvider, createTheme } from '@mantine/core';\n\nimport '../globals.css';\nimport { AuthProvider } from './AuthProvider';\nimport { isLocale, locales, type Locale } from '@/i18n/config';\nimport { loadMessages } from '@/i18n/messages';\nimport LayoutWrapper from '@/components/catalog/LayoutWrapper';\n\nconst plusJakartaSans = Plus_Jakarta_Sans({\n  weight: ['400', '500'],\n  subsets: ['latin'],\n  display: 'swap',\n  variable: '--font-regola',\n});\n\nconst theme = createTheme({\n  primaryColor: 'myGreen',\n  fontFamily: plusJakartaSans.style.fontFamily ?? 'Plus Jakarta Sans, sans-serif',\n  colors: {\n    myGreen: [\n      '#f7f9f8',\n      '#e9f2ec',\n      '#d0e6da',\n      '#b7dac9',\n      '#9eceb7',\n      '#5a9a7c',\n      '#336650',\n      '#2d5a48',\n      '#277730',\n      '#1e5a26',\n    ],\n  },\n});\n\ntype LocaleLayoutProps = {\n  children: ReactNode;\n  params: Promise<{ locale: string }>;\n};\n\nexport function generateStaticParams(): { locale: string }[] {\n  return locales.map((locale) => ({ locale }));\n}\n\n/** Un idioma no soportado (`/fr/...`) responde 404 (AC0.4.2). */\nexport const dynamicParams = false;\n\nexport async function generateMetadata({ params }: LocaleLayoutProps): Promise<Metadata> {\n  const { locale } = await params;\n  if (!isLocale(locale)) return {};\n\n  const t = await getTranslations({ locale, namespace: 'meta' });\n  return { title: t('title') };\n}\n\nexport default async function LocaleLayout({ children, params }: LocaleLayoutProps) {\n  const { locale } = await params;\n  if (!isLocale(locale)) notFound();\n\n  // Habilita el render estático y fija el idioma para las APIs de next-intl.\n  setRequestLocale(locale);\n\n  // Solo el diccionario del idioma activo llega al navegador (AC7.2.4).\n  const messages = await loadMessages(locale);\n\n  return (\n    <html lang={locale} className={plusJakartaSans.className} suppressHydrationWarning>\n      <head>\n        <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n        <ColorSchemeScript />\n      </head>\n      <body>\n        <AuthProvider>\n          <NextIntlClientProvider locale={locale} messages={messages} timeZone=\"America/Bogota\">\n            <MantineProvider theme={theme}>\n              <LayoutWrapper locale={locale}>\n                {children}\n              </LayoutWrapper>\n            </MantineProvider>\n          </NextIntlClientProvider>\n        </AuthProvider>\n      </body>\n    </html>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/home/diego/Documentos/jf-propiedad-raiz-web/packages/client/src/app/[locale]/nosotros/page.tsx","messages":[{"ruleId":"@next/next/no-img-element","severity":1,"message":"Using `<img>` could result in slower LCP and higher bandwidth. Consider using `<Image />` from `next/image` or a custom image loader to automatically optimize images. This may incur additional usage or cost from your provider. See: https://nextjs.org/docs/messages/no-img-element","line":62,"column":23,"nodeType":"JSXOpeningElement","endLine":66,"endColumn":25}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { notFound } from 'next/navigation';\nimport { getTranslations, setRequestLocale } from 'next-intl/server';\nimport { loadMessages } from '@/i18n/messages';\nimport { isLocale } from '@/i18n/config';\n\n\nimport styles from './page.module.css';\n\ntype NosotrosPageProps = {\n  params: Promise<{ locale: string }>;\n};\n\nexport default async function NosotrosPage({ params }: NosotrosPageProps) {\n  const { locale } = await params;\n  if (!isLocale(locale)) notFound();\n\n  setRequestLocale(locale);\n  const t = await getTranslations('about');\n  const messages = await loadMessages(locale);\n  const today = new Date().toLocaleDateString(locale === 'es' ? 'es-CO' : 'en-US');\n\n  const sections = messages.about.sections as Array<{ id: string; titulo: string; cuerpo: string }>;\n  const equipo = messages.about.equipo as Array<{\n    id: string;\n    nombre: string;\n    cargo: string;\n    descripcion?: string;\n    foto?: string | null;\n  }>;\n\n  return (\n      <div className={styles.page}>\n        <div className={styles.content}>\n        <div className={styles.header}>\n          <h1 className={styles.title}>{t('title')}</h1>\n          <p className={styles.lastUpdated}>{t('lastUpdated', { date: today })}</p>\n        </div>\n\n        <section className={styles.extractSection}>\n          <p className={styles.extractText}>{t('extracto')}</p>\n        </section>\n\n        {sections.map((section) => (\n          <section key={section.id} className={styles.section}>\n            <h2 className={styles.sectionTitle}>{section.titulo}</h2>\n            <div className={styles.sectionBody}>\n              {section.cuerpo}\n            </div>\n          </section>\n        ))}\n\n        {equipo.length > 0 && (\n          <section className={styles.teamSection}>\n            <h2 className={styles.sectionTitle}>\n              {locale === 'es' ? 'Nuestro Equipo' : 'Our Team'}\n            </h2>\n            <div className={styles.teamGrid}>\n              {equipo.map((member) => (\n                <article key={member.id} className={styles.teamCard}>\n                  {member.foto && (\n                    <div className={styles.memberPhoto}>\n                      <img\n                        src={member.foto}\n                        alt={member.nombre}\n                        className={styles.memberPhotoImg}\n                      />\n                    </div>\n                  )}\n                  <div className={styles.memberContent}>\n                    <h3 className={styles.memberName}>{member.nombre}</h3>\n                    <p className={styles.memberRole}>{member.cargo}</p>\n                    {member.descripcion && (\n                      <p className={styles.memberDesc}>{member.descripcion}</p>\n                    )}\n                  </div>\n                </article>\n              ))}\n            </div>\n          </section>\n        )}\n      </div>\n    </div>\n  );\n}\n\n","usedDeprecatedRules":[]},{"filePath":"/home/diego/Documentos/jf-propiedad-raiz-web/packages/client/src/app/[locale]/not-found.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/home/diego/Documentos/jf-propiedad-raiz-web/packages/client/src/app/[locale]/page.tsx","messages":[{"ruleId":"@next/next/no-img-element","severity":1,"message":"Using `<img>` could result in slower LCP and higher bandwidth. Consider using `<Image />` from `next/image` or a custom image loader to automatically optimize images. This may incur additional usage or cost from your provider. See: https://nextjs.org/docs/messages/no-img-element","line":35,"column":13,"nodeType":"JSXOpeningElement","endLine":42,"endColumn":15}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { notFound } from 'next/navigation';\nimport { Suspense } from 'react';\nimport { getTranslations, setRequestLocale } from 'next-intl/server';\nimport { getRoute } from '@/i18n/routes';\nimport { loadMessages } from '@/i18n/messages';\nimport { isLocale } from '@/i18n/config';\n\nimport { HeroSearchForm } from '@/components/catalog/HeroSearchForm';\n\nimport styles from './page.module.css';\n\ntype HomePageProps = {\n  params: Promise<{ locale: string }>;\n};\n\nexport default async function HomePage({ params }: HomePageProps) {\n  const { locale } = await params;\n  if (!isLocale(locale)) notFound();\n\n  setRequestLocale(locale);\n  const t = await getTranslations();\n  const tHome = await getTranslations('home');\n  const messages = await loadMessages(locale);\n  const servicesPreview = messages.home.servicesPreview;\n\n  const aboutExtract = tHome('aboutExtract');\n  const aboutUrl = getRoute('about', locale);\n\n  return (\n    <div className={styles.page}>\n      <main className={styles.main}>\n        {/* HERO */}\n        <section className={styles.hero} aria-labelledby=\"hero-title\">\n          <div className={styles.heroBackground} aria-hidden=\"true\">\n            <img\n              className={styles.heroImage}\n              src=\"/images/hero-default.jpg\"\n              alt=\"Inmueble en el Valle de Aburrá\"\n              width=\"1200\"\n              height=\"600\"\n              loading=\"eager\"\n            />\n            <div className={styles.heroOverlay} />\n          </div>\n          <div className={styles.heroContent}>\n            <h1 id=\"hero-title\" className={styles.heroTitle}>\n              {t('home.title')}\n            </h1>\n            <p className={styles.heroSubtitle}>{t('home.intro')}</p>\n            <nav className={styles.quickAccess} aria-label={tHome('quickAccessAriaLabel')}>\n              <a href={getRoute('sale', locale)} className={styles.quickLink}>\n                <span className={styles.quickLinkIcon}>🏠</span>\n                {t('nav.sale')}\n              </a>\n              <a href={getRoute('rent', locale)} className={styles.quickLink}>\n                <span className={styles.quickLinkIcon}>🏘️</span>\n                {t('nav.rent')}\n              </a>\n              <a href={getRoute('projects', locale)} className={styles.quickLink}>\n                <span className={styles.quickLinkIcon}>🏗️</span>\n                {t('nav.projects')}\n              </a>\n            </nav>\n            <Suspense fallback={<div className={styles.searchFallback} />}>\n              <HeroSearchForm locale={locale} />\n            </Suspense>\n          </div>\n        </section>\n\n        {/* DESTACADAS */}\n        <section className={styles.featuredSection} aria-labelledby=\"featured-title\">\n          <header className={styles.sectionHeader}>\n            <h2 id=\"featured-title\" className={styles.sectionTitle}>\n              {t('home.featured')}\n            </h2>\n            <p className={styles.sectionSubtitle}>{tHome('featuredSubtitle')}</p>\n          </header>\n          <div className={styles.featuredGrid} role=\"list\">\n            {Array.from({ length: 4 }).map((_, i) => (\n              <article key={i} className={styles.featuredCard} role=\"listitem\">\n                <div className={styles.featuredImage} aria-hidden=\"true\" />\n                <div className={styles.featuredBadge}>\n                  {tHome('operation')}\n                </div>\n                <h3 className={styles.featuredTitle}>\n                  {tHome('featuredCardTitle', { index: i + 1 })}\n                </h3>\n                <p className={styles.featuredPrice}>$ 450.000.000</p>\n                <div className={styles.featuredSpecs}>\n                  <span>{tHome('featuredCardLocation')}</span>\n                  <span>{tHome('featuredCardBedrooms', { count: 3 })}</span>\n                  <span>{tHome('featuredCardBathrooms', { count: 2 })}</span>\n                  <span>{tHome('featuredCardArea', { area: '120' })}</span>\n                </div>\n                <a href=\"#\" className={styles.featuredLink}>\n                  {t('property.details')}\n                </a>\n              </article>\n            ))}\n          </div>\n          <footer className={styles.sectionFooter}>\n            <a href={getRoute('sale', locale)} className={styles.sectionLink}>\n              {tHome('viewAllSale')}\n              <span className={styles.arrow}>→</span>\n            </a>\n          </footer>\n        </section>\n\n        {/* SERVICIOS PREVIEW */}\n        <section\n          className={`${styles.section} ${styles.servicesPreview}`}\n          aria-labelledby=\"services-title\"\n        >\n          <header className={styles.sectionHeader}>\n            <h2 id=\"services-title\" className={styles.sectionTitle}>\n              {t('nav.services')}\n            </h2>\n            <p className={styles.sectionSubtitle}>{tHome('servicesPreviewSubtitle')}</p>\n          </header>\n          <div className={styles.servicesGrid} role=\"list\">\n            {servicesPreview.map((service: { id: string; title: string; description: string; icon: string }) => (\n              <article key={service.id} className={styles.serviceCard} role=\"listitem\">\n                <div className={styles.serviceIcon} aria-hidden=\"true\">\n                  {service.icon === 'home' && (\n                    <span className={styles.iconHome}>🏠</span>\n                  )}\n                  {service.icon === 'building' && (\n                    <span className={styles.iconBuilding}>🏗️</span>\n                  )}\n                  {service.icon === 'calculator' && (\n                    <span className={styles.iconCalculator}>🧮</span>\n                  )}\n                </div>\n                <h3 className={styles.serviceTitle}>{service.title}</h3>\n                <p className={styles.serviceDescription}>{service.description}</p>\n                <a href={getRoute('services', locale)} className={styles.serviceLink}>\n                  {tHome('learnMore')}\n                  <span className={styles.arrow}>→</span>\n                </a>\n              </article>\n            ))}\n          </div>\n          <footer className={styles.sectionFooter}>\n            <a href={getRoute('contact', locale)} className={styles.aboutLink}>\n              {tHome('viewAllServicesContact')}\n              <span className={styles.arrow}>→</span>\n            </a>\n          </footer>\n        </section>\n\n        {/* NOSOTROS */}\n        <section className={styles.aboutBlock} aria-labelledby=\"about-title\">\n          <div className={styles.aboutContent}>\n            <h2 id=\"about-title\" className={styles.aboutTitle}>\n              {t('nav.about')}\n            </h2>\n            <p className={styles.aboutExtract}>{aboutExtract}</p>\n            <a href={aboutUrl} className={styles.aboutLink}>\n              {tHome('learnMore')}\n              <span className={styles.arrow}>→</span>\n            </a>\n          </div>\n          <div className={styles.aboutImage} aria-hidden=\"true\">\n            <div className={styles.aboutImagePlaceholder} />\n            <span className={styles.aboutImageAlt}>{tHome('aboutImageAlt')}</span>\n          </div>\n        </section>\n\n        {/* ALIADOS */}\n        <section className={styles.partnersSection} aria-labelledby=\"partners-title\">\n          <header className={styles.sectionHeader}>\n            <h2 id=\"partners-title\" className={styles.sectionTitle}>\n              {tHome('partnersTitle')}\n            </h2>\n            <p className={styles.sectionSubtitle}>{tHome('partnersSubtitle')}</p>\n          </header>\n          <div className={styles.partnersGrid} role=\"list\" aria-label={tHome('partnersAriaLabel')}>\n            {(messages.home.partners as unknown as string[]).map((name: string) => (\n              <div key={name} className={styles.partnerLogo} role=\"listitem\" aria-label={name}>\n                {name}\n              </div>\n            ))}\n          </div>\n        </section>\n      </main>\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/home/diego/Documentos/jf-propiedad-raiz-web/packages/client/src/app/[locale]/politica-de-tratamiento-de-datos/page.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/home/diego/Documentos/jf-propiedad-raiz-web/packages/client/src/app/[locale]/propiedad/[slug]/page.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'ReactElement' is defined but never used.","line":9,"column":17,"nodeType":"Identifier","messageId":"unusedVar","endLine":9,"endColumn":29,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"ReactElement"},"fix":{"range":[379,397],"text":""},"desc":"Remove unused variable \"ReactElement\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'generateMetadata' is defined but never used.","line":31,"column":16,"nodeType":"Identifier","messageId":"unusedVar","endLine":31,"endColumn":32},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'t' is assigned a value but never used.","line":38,"column":9,"nodeType":"Identifier","messageId":"unusedVar","endLine":38,"endColumn":10},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'hasFullTranslation' is assigned a value but never used.","line":148,"column":9,"nodeType":"Identifier","messageId":"unusedVar","endLine":148,"endColumn":27},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'canonicalUrl' is assigned a value but never used.","line":150,"column":9,"nodeType":"Identifier","messageId":"unusedVar","endLine":150,"endColumn":21},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'portada' is assigned a value but never used.","line":157,"column":9,"nodeType":"Identifier","messageId":"unusedVar","endLine":157,"endColumn":16}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":6,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { notFound } from 'next/navigation';\nimport { Metadata } from 'next';\nimport { setRequestLocale, getTranslations } from 'next-intl/server';\nimport { getRoute } from '@/i18n/routes';\nimport { isLocale } from '@/i18n/config';\nimport { fetchPropertyBySlug } from '@/lib/api-catalog';\nimport { getOperacionLabel } from '@/components/catalog/property-card-utils';\n\nimport React, { ReactElement } from 'react';\nimport { PropertyGallery } from '@/components/catalog/PropertyGallery';\nimport { PropertyStickySidebar } from '@/components/catalog/PropertyStickySidebar';\nimport { PropertySpecs } from '@/components/catalog/PropertySpecs';\nimport { PropertyPOIs } from '@/components/catalog/PropertyPOIs';\nimport { VideoFacade } from '@/components/catalog/VideoFacade';\nimport { PanoramaViewer } from '@/components/catalog/PanoramaViewer';\n\nimport styles from './page.module.css';\n\ntype PropiedadDetailPageProps = {\n  params: Promise<{ locale: string; slug: string }>;\n};\n\nasync function fetchPropertyOrNotFound(slug: string, locale: string) {\n  const response = await fetchPropertyBySlug(slug, locale as 'es' | 'en');\n  if (!response.success || !response.data) {\n    notFound();\n  }\n  return response.data;\n}\n\nasync function generateMetadata({ params }: PropiedadDetailPageProps): Promise<Metadata> {\n  const { locale, slug } = await params;\n  if (!isLocale(locale)) return {};\n\n  const property = await fetchPropertyOrNotFound(slug, locale);\n  if (property.status !== 'ACTIVE') return {};\n\n  const t = await getTranslations('property');\n\n  const baseUrl = process.env.NEXT_PUBLIC_SITE_URL || 'https://jfpropiedadraiz.com';\n  const canonicalUrl = `${baseUrl}${getRoute('property', locale, { slug })}`;\n  const alternateEs = `${baseUrl}${getRoute('property', 'es', { slug })}`;\n  const alternateEn = `${baseUrl}${getRoute('property', 'en', { slug })}`;\n\n  const titulo = property.titulo[locale] ?? property.titulo.es ?? '';\n  const descripcion = property.descripcion[locale] ?? property.descripcion.es ?? '';\n  const portadaDerivados = property.fotos?.[0]?.derivados;\n  const portada =\n    portadaDerivados?.[2]?.clave ?? portadaDerivados?.[1]?.clave ?? portadaDerivados?.[0]?.clave;\n  const imageUrl = portada ? `${baseUrl}/${portada}` : `${baseUrl}/og-default.jpg`;\n\n  const jsonLd = {\n    '@context': 'https://schema.org',\n    '@type': 'RealEstateListing',\n    name: titulo,\n    description: descripcion,\n    url: canonicalUrl,\n    image: imageUrl,\n    offers: {\n      '@type': 'Offer',\n      price: property.precio,\n      priceCurrency: 'COP',\n      priceSpecification: {\n        '@type': 'UnitPriceSpecification',\n        priceCurrency: 'COP',\n        price: property.precio,\n      },\n      availability: 'https://schema.org/InStock',\n    },\n    address: {\n      '@type': 'PostalAddress',\n      addressLocality: property.municipio,\n      addressRegion: property.departamento,\n      addressCountry: 'CO',\n    },\n    floorSize: property.areaConstruida\n      ? {\n          '@type': 'QuantitativeValue',\n          value: property.areaConstruida,\n          unitCode: 'MTK',\n        }\n      : undefined,\n    numberOfRooms: property.dormitorios,\n    numberOfBathroomsTotal: property.banos,\n    inLanguage: locale === 'es' ? 'es-CO' : 'en',\n    publisher: {\n      '@type': 'Organization',\n      name: 'JF Propiedad Raíz',\n      url: baseUrl,\n    },\n  };\n\n  const cleanJsonLd = JSON.parse(JSON.stringify(jsonLd));\n\n  return {\n    title: `${titulo} | JF Propiedad Raíz`,\n    description: descripcion.slice(0, 160),\n    alternates: {\n      canonical: canonicalUrl,\n      languages: {\n        'es-CO': alternateEs,\n        en: alternateEn,\n        'x-default': alternateEs,\n      },\n    },\n    openGraph: {\n      title: titulo,\n      description: descripcion.slice(0, 160),\n      url: canonicalUrl,\n      type: 'website',\n      locale: locale === 'es' ? 'es-CO' : 'en_US',\n      siteName: 'JF Propiedad Raíz',\n      images: [\n        {\n          url: imageUrl,\n          width: 1280,\n          height: 720,\n          alt: titulo,\n        },\n      ],\n    },\n    twitter: {\n      card: 'summary_large_image',\n      title: titulo,\n      description: descripcion.slice(0, 160),\n      images: [imageUrl],\n    },\n    robots: {\n      index: !!(property.titulo.en && property.descripcion.en),\n      follow: true,\n    },\n    other: {\n      'application/ld+json': JSON.stringify(cleanJsonLd),\n    },\n  };\n}\n\nexport default async function PropiedadDetailPage({ params }: PropiedadDetailPageProps) {\n  const { locale, slug } = await params;\n  if (!isLocale(locale)) notFound();\n\n  setRequestLocale(locale);\n\n  const tProperty = await getTranslations('property');\n\n  const property = await fetchPropertyOrNotFound(slug, locale);\n\n  const hasFullTranslation = !!(property.titulo.en && property.descripcion.en);\n  const baseUrl = process.env.NEXT_PUBLIC_SITE_URL || 'https://jfpropiedadraiz.com';\n  const canonicalUrl = `${baseUrl}${getRoute('property', locale, { slug })}`;\n  const alternateEs = `${baseUrl}${getRoute('property', 'es', { slug })}`;\n  const alternateEn = `${baseUrl}${getRoute('property', 'en', { slug })}`;\n\n  const titulo = property.titulo[locale] ?? property.titulo.es ?? '';\n  const descripcion = property.descripcion[locale] ?? property.descripcion.es ?? '';\n  const portadaDerivados = property.fotos?.[0]?.derivados;\n  const portada =\n    portadaDerivad