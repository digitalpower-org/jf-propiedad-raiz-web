er","messageId":"unusedVar","endLine":102,"endColumn":24}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"'use client';\nimport { useRouter, useSearchParams } from 'next/navigation';\nimport { useState, useEffect, useRef } from 'react';\nimport { Checkbox, Select, Input, Button, Group, Text, Grid, Divider } from '@mantine/core';\nimport type { TipoInmueble, Operacion } from '@jf/shared-types';\nimport styles from './Filters.module.css';\nexport interface PropertyFilters {\n  tipo?: string | undefined;\n  departamento?: string | undefined;\n  municipio?: string | undefined;\n  precioMin?: number | undefined;\n  precioMax?: number | undefined;\n  dormitorios?: string | undefined;\n  banos?: string | undefined;\n  areaMin?: string | undefined;\n  estrato?: string | undefined;\n  destacada?: boolean | undefined;\n}\n\ninterface FiltersProps {\n  readonly operacion: Operacion;\n  readonly locale: 'es' | 'en';\n  readonly onFiltersChange?: (filters: PropertyFilters) => void;\n  readonly initialFilters?: PropertyFilters;\n}\n\nconst TIPO_INMUEBLE_OPTIONS = {\n  es: [\n    { value: 'CASA', label: 'Casa' },\n    { value: 'APARTAMENTO', label: 'Apartamento' },\n    { value: 'LOTE_CAMPESTRE', label: 'Lote Campestre' },\n    { value: 'LOTE_URBANO', label: 'Lote Urbano' },\n    { value: 'FINCA', label: 'Finca' },\n    { value: 'LOCAL_COMERCIAL', label: 'Local Comercial' },\n    { value: 'BODEGA', label: 'Bodega' },\n    { value: 'OFICINA', label: 'Oficina' },\n  ],\n  en: [\n    { value: 'CASA', label: 'House' },\n    { value: 'APARTAMENTO', label: 'Apartment' },\n    { value: 'LOTE_CAMPESTRE', label: 'Country Lot' },\n    { value: 'LOTE_URBANO', label: 'Urban Lot' },\n    { value: 'FINCA', label: 'Farm' },\n    { value: 'LOCAL_COMERCIAL', label: 'Commercial Space' },\n    { value: 'BODEGA', label: 'Warehouse' },\n    { value: 'OFICINA', label: 'Office' },\n  ],\n};\n\nconst DEPARTAMENTO_OPTIONS = {\n  es: [\n    { value: 'Antioquia', label: 'Antioquia' },\n    { value: 'Cundinamarca', label: 'Cundinamarca' },\n    { value: 'Valle del Cauca', label: 'Valle del Cauca' },\n    { value: 'Atlántico', label: 'Atlántico' },\n    { value: 'Santander', label: 'Santander' },\n    { value: 'Bolívar', label: 'Bolívar' },\n  ],\n  en: [\n    { value: 'Antioquia', label: 'Antioquia' },\n    { value: 'Cundinamarca', label: 'Cundinamarca' },\n    { value: 'Valle del Cauca', label: 'Valle del Cauca' },\n    { value: 'Atlántico', label: 'Atlántico' },\n    { value: 'Santander', label: 'Santander' },\n    { value: 'Bolívar', label: 'Bolívar' },\n  ],\n};\n\nconst MUNICIPIO_OPTIONS: Record<string, { es: string; en: string }[]> = {\n  Antioquia: [\n    { es: 'Medellín', en: 'Medellín' },\n    { es: 'Envigado', en: 'Envigado' },\n    { es: 'Itagüí', en: 'Itagüí' },\n    { es: 'Bello', en: 'Bello' },\n    { es: 'Sabaneta', en: 'Sabaneta' },\n    { es: 'Rionegro', en: 'Rionegro' },\n    { es: 'Copacabana', en: 'Copacabana' },\n  ],\n  Cundinamarca: [\n    { es: 'Bogotá', en: 'Bogotá' },\n    { es: 'Soacha', en: 'Soacha' },\n    { es: 'Chía', en: 'Chía' },\n    { es: 'Cajicá', en: 'Cajicá' },\n  ],\n  'Valle del Cauca': [\n    { es: 'Cali', en: 'Cali' },\n    { es: 'Palmira', en: 'Palmira' },\n    { es: 'Tuluá', en: 'Tuluá' },\n  ],\n  Atlántico: [\n    { es: 'Barranquilla', en: 'Barranquilla' },\n    { es: 'Soledad', en: 'Soledad' },\n  ],\n  Santander: [\n    { es: 'Bucaramanga', en: 'Bucaramanga' },\n    { es: 'Floridablanca', en: 'Floridablanca' },\n  ],\n  Bolívar: [{ es: 'Cartagena', en: 'Cartagena' }],\n};\n\nexport function Filters({\n  operacion: _operacion,\n  locale,\n  onFiltersChange,\n  initialFilters,\n}: FiltersProps) {\n  const router = useRouter();\n  const searchParams = useSearchParams();\n\n  // Helper to parse searchParams into initial state\n  const getInitialState = (params: URLSearchParams) => ({\n    tipo: params.get('tipo') ? (params.get('tipo')!.split(',') as TipoInmueble[]) : [],\n    departamento: params.get('departamento') || '',\n    municipio: params.get('municipio') || '',\n    precioMin: params.get('precioMin') || '',\n    precioMax: params.get('precioMax') || '',\n    destacada: params.get('destacada') === 'true',\n    dormitorios: params.get('dormitorios') || '',\n    banos: params.get('banos') || '',\n    areaMin: params.get('areaMin') || '',\n    estrato: params.get('estrato') || '',\n  });\n\n  const initialState = getInitialState(searchParams);\n\n  // Merge URL params with initialFilters prop (prop takes precedence)\n  const mergedTipo = initialFilters?.tipo\n    ? ([initialFilters.tipo] as TipoInmueble[])\n    : initialState.tipo;\n  const mergedDepartamento = initialFilters?.departamento ?? initialState.departamento;\n  const mergedMunicipio = initialFilters?.municipio ?? initialState.municipio;\n  const mergedPrecioMin = initialFilters?.precioMin\n    ? String(initialFilters.precioMin)\n    : initialState.precioMin;\n  const mergedPrecioMax = initialFilters?.precioMax\n    ? String(initialFilters.precioMax)\n    : initialState.precioMax;\n  const mergedDestacada = initialFilters?.destacada ?? initialState.destacada;\n  const mergedDormitorios = initialFilters?.dormitorios ?? initialState.dormitorios;\n  const mergedBanos = initialFilters?.banos ?? initialState.banos;\n  const mergedAreaMin = initialFilters?.areaMin ?? initialState.areaMin;\n  const mergedEstrato = initialFilters?.estrato ?? initialState.estrato;\n\n  const [tipo, setTipo] = useState<TipoInmueble[]>(mergedTipo);\n  const [departamento, setDepartamento] = useState<string>(mergedDepartamento);\n  const [municipio, setMunicipio] = useState<string>(mergedMunicipio);\n  const [precioMin, setPrecioMin] = useState<string>(mergedPrecioMin);\n  const [precioMax, setPrecioMax] = useState<string>(mergedPrecioMax);\n  const [destacada, setDestacada] = useState<boolean>(mergedDestacada);\n  const [dormitorios, setDormitorios] = useState<string>(mergedDormitorios);\n  const [banos, setBanos] = useState<string>(mergedBanos);\n  const [areaMin, setAreaMin] = useState<string>(mergedAreaMin);\n  const [estrato, setEstrato] = useState<string>(mergedEstrato);\n\n  // Sync with URL changes (only after initial render)\n  const isFirstRender = useRef(true);\n  useEffect(() => {\n    if (isFirstRender.current) {\n      isFirstRender.current = false;\n      return;\n    }\n    const params = new URLSearchParams(searchParams.toString());\n    const newState = getInitialState(params);\n    setTipo(newState.tipo);\n    setDepartamento(newState.departamento);\n    setMunicipio(newState.municipio);\n    setPrecioMin(newState.precioMin);\n    setPrecioMax(newState.precioMax);\n    setDestacada(newState.destacada);\n    setDormitorios(newState.dormitorios);\n    setBanos(newState.banos);\n    setAreaMin(newState.areaMin);\n    setEstrato(newState.estrato);\n  }, [searchParams]);\n\n  const notifyFiltersChange = () => {\n    if (onFiltersChange) {\n      onFiltersChange({\n        tipo: tipo.length > 0 ? tipo.join(',') : undefined,\n        departamento: departamento || undefined,\n        municipio: municipio || undefined,\n        precioMin: precioMin ? Number(precioMin) : undefined,\n        precioMax: precioMax ? Number(precioMax) : undefined,\n        dormitorios: dormitorios || undefined,\n        banos: banos || undefined,\n        areaMin: areaMin || undefined,\n        estrato: estrato || undefined,\n        destacada: destacada || undefined,\n      });\n    }\n  };\n\n  const updateUrl = () => {\n    const params = new URLSearchParams();\n    if (tipo.length > 0) params.set('tipo', tipo.join(','));\n    if (departamento) params.set('departamento', departamento);\n    if (municipio) params.set('municipio', municipio);\n    if (precioMin) params.set('precioMin', precioMin);\n    if (precioMax) params.set('precioMax', precioMax);\n    if (destacada) params.set('destacada', 'true');\n    if (dormitorios) params.set('dormitorios', dormitorios);\n    if (banos) params.set('banos', banos);\n    if (areaMin) params.set('areaMin', areaMin);\n    if (estrato) params.set('estrato', estrato);\n\n    const currentPath = window.location.pathname;\n    const newUrl = params.toString() ? `${currentPath}?${params.toString()}` : currentPath;\n    router.push(newUrl, { scroll: false });\n    notifyFiltersChange();\n  };\n\n  const handleClear = () => {\n    setTipo([]);\n    setDepartamento('');\n    setMunicipio('');\n    setPrecioMin('');\n    setPrecioMax('');\n    setDestacada(false);\n    setDormitorios('');\n    setBanos('');\n    setAreaMin('');\n    setEstrato('');\n    router.push(window.location.pathname, { scroll: false });\n    notifyFiltersChange();\n  };\n\n  const hasActiveFilters =\n    tipo.length > 0 ||\n    departamento ||\n    municipio ||\n    precioMin ||\n    precioMax ||\n    destacada ||\n    dormitorios ||\n    banos ||\n    areaMin ||\n    estrato;\n\n  const t = {\n    es: {\n      title: 'Filtros',\n      tipo: 'Tipo de inmueble',\n      ubicacion: 'Ubicación',\n      departamento: 'Departamento',\n      municipio: 'Municipio',\n      precio: 'Rango de precio (COP)',\n      min: 'Mín',\n      max: 'Máx',\n      destacada: 'Solo destacadas',\n      dormitorios: 'Dormitorios mín.',\n      banos: 'Baños mín.',\n      area: 'Área mín. (m²)',\n      estrato: 'Estrato',\n      aplicar: 'Aplicar',\n      limpiar: 'Limpiar',\n      clearAll: 'Limpiar todos',\n    },\n    en: {\n      title: 'Filters',\n      tipo: 'Property Type',\n      ubicacion: 'Location',\n      departamento: 'Department',\n      municipio: 'Municipality',\n      precio: 'Price Range (COP)',\n      min: 'Min',\n      max: 'Max',\n      destacada: 'Featured Only',\n      dormitorios: 'Min Bedrooms',\n      banos: 'Min Bathrooms',\n      area: 'Min Area (m²)',\n      estrato: 'Stratum',\n      aplicar: 'Apply',\n      limpiar: 'Clear',\n      clearAll: 'Clear All',\n    },\n  }[locale];\n\n  const municipioOptions = departamento ? MUNICIPIO_OPTIONS[departamento] || [] : [];\n\n  return (\n    <div className={styles.container}>\n      <div className={styles.header}>\n        <h2 className={styles.title}>{t.title}</h2>\n        {hasActiveFilters && (\n          <Button\n            variant=\"subtle\"\n            color=\"gray\"\n            size=\"sm\"\n            onClick={handleClear}\n            className={styles.clearAllBtn}\n          >\n            {t.clearAll}\n          </Button>\n        )}\n      </div>\n\n      <Grid\n        className={styles.grid}\n      >\n        {/* Tipo de inmueble */}\n        <div className={`${styles.field} ${styles.fieldSpan2}`}>\n          <Text size=\"sm\" fw={500} c=\"dimmed\" className={styles.label}>\n            {t.tipo}\n          </Text>\n          <Group grow>\n            {TIPO_INMUEBLE_OPTIONS[locale].map((opt) => (\n              <Checkbox\n                key={opt.value}\n                label={opt.label}\n                checked={tipo.includes(opt.value as TipoInmueble)}\n                onChange={(e) =>\n                  setTipo((prev) =>\n                    e.currentTarget.checked\n                      ? [...prev, opt.value as TipoInmueble]\n                      : prev.filter((t) => t !== opt.value),\n                  )\n                }\n                size=\"sm\"\n              />\n            ))}\n          </Group>\n        </div>\n\n        {/* Ubicación - Departamento */}\n        <div className={styles.field}>\n          <Text size=\"sm\" fw={500} c=\"dimmed\" className={styles.label}>\n            {t.departamento}\n          </Text>\n          <Select\n            placeholder={t.departamento}\n            value={departamento}\n            onChange={(value) => {\n              setDepartamento(value || '');\n              setMunicipio('');\n            }}\n            data={DEPARTAMENTO_OPTIONS[locale].map((d) => ({ value: d.value, label: d.label }))}\n            size=\"sm\"\n            clearable\n          />\n        </div>\n\n        {/* Ubicación - Municipio */}\n        <div className={styles.field}>\n          <Text size=\"sm\" fw={500} c=\"dimmed\" className={styles.label}>\n            {t.municipio}\n          </Text>\n          <Select\n            placeholder={t.municipio}\n            value={municipio}\n            onChange={(value) => setMunicipio(value || '')}\n            data={municipioOptions.map((m) => ({ value: m.es, label: m[locale] }))}\n            size=\"sm\"\n            clearable\n            disabled={!departamento}\n          />\n        </div>\n\n        {/* Precio */}\n        <div className={styles.field}>\n          <Text size=\"sm\" fw={500} c=\"dimmed\" className={styles.label}>\n            {t.precio}\n          </Text>\n          <Grid gap={2} className={styles.priceGrid}>\n            <Input\n              type=\"number\"\n              placeholder={t.min}\n              value={precioMin}\n              onChange={(e) => setPrecioMin(e.target.value)}\n              size=\"sm\"\n              min={0}\n              step={100000}\n            />\n            <Input\n              type=\"number\"\n              placeholder={t.max}\n              value={precioMax}\n              onChange={(e) => setPrecioMax(e.target.value)}\n              size=\"sm\"\n              min={0}\n              step={100000}\n            />\n          </Grid>\n        </div>\n\n        {/* Destacada */}\n        <div className={`${styles.field} ${styles.featuredField}`}>\n          <Checkbox\n            label={t.destacada}\n            checked={destacada}\n            onChange={(e) => setDestacada(e.currentTarget.checked)}\n            size=\"sm\"\n          />\n        </div>\n\n        {/* Dormitorios */}\n        <div className={styles.field}>\n          <Text size=\"sm\" fw={500} c=\"dimmed\" className={styles.label}>\n            {t.dormitorios}\n          </Text>\n          <Select\n            placeholder={t.dormitorios}\n            value={dormitorios}\n            onChange={(value) => setDormitorios(value || '')}\n            data={[\n              { value: '1', label: '1+' },\n              { value: '2', label: '2+' },\n              { value: '3', label: '3+' },\n              { value: '4', label: '4+' },\n              { value: '5', label: '5+' },\n            ]}\n            size=\"sm\"\n            clearable\n          />\n        </div>\n\n        {/* Baños */}\n        <div className={styles.field}>\n          <Text size=\"sm\" fw={500} c=\"dimmed\" className={styles.label}>\n            {t.banos}\n          </Text>\n          <Select\n            placeholder={t.banos}\n            value={banos}\n            onChange={(value) => setBanos(value || '')}\n            data={[\n              { value: '1', label: '1+' },\n              { value: '2', label: '2+' },\n              { value: '3', label: '3+' },\n              { value: '4', label: '4+' },\n            ]}\n            size=\"sm\"\n            clearable\n          />\n        </div>\n\n        {/* Área mínima */}\n        <div className={styles.field}>\n          <Text size=\"sm\" fw={500} c=\"dimmed\" className={styles.label}>\n            {t.area}\n          </Text>\n          <Input\n            type=\"number\"\n            placeholder={t.area}\n            value={areaMin}\n            onChange={(e) => setAreaMin(e.target.value)}\n            size=\"sm\"\n            min={0}\n            step={10}\n          />\n        </div>\n\n        {/* Estrato */}\n        <div className={styles.field}>\n          <Text size=\"sm\" fw={500} c=\"dimmed\" className={styles.label}>\n            {t.estrato}\n          </Text>\n          <Select\n            placeholder={t.estrato}\n            value={estrato}\n            onChange={(value) => setEstrato(value || '')}\n            data={[\n              { value: '1', label: '1' },\n              { value: '2', label: '2' },\n              { value: '3', label: '3' },\n              { value: '4', label: '4' },\n              { value: '5', label: '5' },\n              { value: '6', label: '6' },\n            ]}\n            size=\"sm\"\n            clearable\n          />\n        </div>\n      </Grid>\n\n      <Divider my=\"md\" />\n\n      <Group justify=\"flex-end\" gap={2} className={styles.actions}>\n        <Button variant=\"subtle\" color=\"gray\" onClick={handleClear} size=\"sm\">\n          {t.limpiar}\n        </Button>\n        <Button onClick={updateUrl} size=\"sm\">\n          {t.aplicar}\n        </Button>\n      </Group>\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/home/diego/Documentos/jf-propiedad-raiz-web/packages/client/src/components/catalog/HeroSearchForm.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/home/diego/Documentos/jf-propiedad-raiz-web/packages/client/src/components/catalog/LayoutWrapper.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/home/diego/Documentos/jf-propiedad-raiz-web/packages/client/src/components/catalog/NavbarClient.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/home/diego/Documentos/jf-propiedad-raiz-web/packages/client/src/components/catalog/PanoramaViewer.test.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/home/diego/Documentos/jf-propiedad-raiz-web/packages/client/src/components/catalog/PanoramaViewer.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'PannellumModule' is defined but never used.","line":16,"column":11,"nodeType":"Identifier","messageId":"unusedVar","endLine":16,"endColumn":26},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'pannellum' is assigned a value but never used.","line":30,"column":15,"nodeType":"Identifier","messageId":"unusedVar","endLine":30,"endColumn":24},{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'pannellumViewer'. Either include it or remove the dependency array.","line":96,"column":6,"nodeType":"ArrayExpression","endLine":96,"endColumn":28,"suggestions":[{"desc":"Update the dependencies array to be: [openIndex, pannellumViewer, panoramas]","fix":{"range":[2840,2862],"text":"[openIndex, pannellumViewer, panoramas]"}}]},{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"The ref value 'initializedRef.current' will likely have changed by the time this effect cleanup function runs. If this ref points to a node rendered by React, copy 'initializedRef.current' to a variable inside the effect, and use that variable in the cleanup function.","line":101,"column":22,"nodeType":"Identifier","endLine":101,"endColumn":29},{"ruleId":"@next/next/no-img-element","severity":1,"message":"Using `<img>` could result in slower LCP and higher bandwidth. Consider using `<Image />` from `next/image` or a custom image loader to automatically optimize images. This may incur additional usage or cost from your provider. See: https://nextjs.org/docs/messages/no-img-element","line":121,"column":17,"nodeType":"JSXOpeningElement","endLine":128,"endColumn":19}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":5,"fixableErrorCount":0,"fixableWarningCount":0,"source":"'use client';\nimport { useState, useEffect, useRef, useCallback } from 'react';\nimport { useTranslations } from 'next-intl';\nimport type { Panorama, DerivadoImagen } from '@jf/shared-types';\nimport styles from './PanoramaViewer.module.css';\n\ninterface PanoramaViewerProps {\n  readonly panoramas: readonly Panorama[];\n  readonly locale: 'es' | 'en';\n}\n\ninterface PannellumViewer {\n  destroy: () => void;\n}\n\ninterface PannellumModule {\n  viewer: (container: HTMLElement, options: unknown) => PannellumViewer;\n}\n\nexport function PanoramaViewer({ panoramas, locale }: PanoramaViewerProps) {\n  const t = useTranslations('property');\n  const [openIndex, setOpenIndex] = useState<number | null>(null);\n  const [pannellumViewer, setPannellumViewer] = useState<PannellumViewer | null>(null);\n  const viewerRef = useRef<HTMLDivElement>(null);\n  const initializedRef = useRef<Set<number>>(new Set());\n\n  const loadPannellum = useCallback(() => {\n    import('pannellum')\n      .then((module) => {\n        const pannellum = module.default || module;\n        setPannellumViewer(() => ({\n          destroy: () => {\n            // Pannellum doesn't have a standard destroy method on the module\n            // We'll just set to null and let React handle cleanup\n          },\n        }));\n      })\n      .catch(() => {\n        // Silently fail - Pannellum is optional\n      });\n  }, []);\n\n  useEffect(() => {\n    if (openIndex !== null) {\n      loadPannellum();\n    }\n  }, [openIndex, loadPannellum]);\n\n  useEffect(() => {\n    if (!pannellumViewer || openIndex === null || !viewerRef.current) return;\n    if (initializedRef.current.has(openIndex)) return;\n\n    const panorama = panoramas[openIndex];\n    if (!panorama || panorama.derivados.length === 0) return;\n\n    const bestDerivative = panorama.derivados.reduce<DerivadoImagen>(\n      (best, current) => (current.ancho > best.ancho ? current : best),\n      panorama.derivados[0]!,\n    );\n\n    const panoramaUrl = `/${bestDerivative.clave}`;\n\n    try {\n      // @ts-expect-error - pannellum is dynamically loaded\n      const viewer = window.pannellum?.viewer(viewerRef.current!, {\n        type: 'equirectangular',\n        panorama: panoramaUrl,\n        autoLoad: true,\n        showZoomCtrl: true,\n        showFullscreenCtrl: true,\n        keyboardZoom: true,\n        mouseZoom: true,\n        touchZoom: true,\n        autoRotate: -2,\n        autoRotateInactivityDelay: 3000,\n        hfov: 100,\n        minHfov: 50,\n        maxHfov: 120,\n        pitch: 0,\n        yaw: 0,\n        minPitch: -90,\n        maxPitch: 90,\n        minYaw: -180,\n        maxYaw: 180,\n        compass: true,\n        northOffset: 0,\n        showControls: true,\n        orientationOnByDefault: false,\n      });\n      if (viewer) {\n        initializedRef.current.add(openIndex);\n      }\n    } catch {\n      // Silently fail\n    }\n  }, [openIndex, panoramas]);\n\n  useEffect(() => {\n    return () => {\n      // Cleanup is handled by Pannellum internally\n      initializedRef.current.clear();\n    };\n  }, []);\n\n  if (!panoramas || panoramas.length === 0) return null;\n\n  return (\n    <section className={styles.section} aria-labelledby={styles.titleId}>\n      <h2 id={styles.titleId} className={styles.title}>\n        {t('virtualTour')}\n      </h2>\n      <div className={styles.grid} role=\"list\">\n        {panoramas.map((panorama, index) => {\n          const bestDerivative = panorama.derivados.reduce<DerivadoImagen>(\n            (best, current) => (current.ancho > best.ancho ? current : best),\n            panorama.derivados[0]!,\n          );\n          return (\n            <article key={index} className={styles.card} role=\"listitem\">\n              <div className={styles.thumbnailWrapper}>\n                <img\n                  src={`/${bestDerivative.clave}`}\n                  alt={`${t('virtualTour')} ${index + 1}`}\n                  className={styles.thumbnail}\n                  loading=\"lazy\"\n                  width=\"400\"\n                  height=\"200\"\n                />\n                <button\n                  className={styles.viewBtn}\n                  onClick={() => setOpenIndex(index)}\n                  aria-label={`${t('virtualTour')} ${index + 1}`}\n                >\n                  <svg\n                    viewBox=\"0 0 24 24\"\n                    fill=\"none\"\n                    stroke=\"currentColor\"\n                    strokeWidth=\"1.5\"\n                    aria-hidden=\"true\"\n                  >\n                    <path d=\"M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7\" />\n                    <path d=\"M16 3h5v5\" />\n                    <path d=\"M8 21V6a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v7\" />\n                    <path d=\"M3 10h18\" />\n                  </svg>\n                  <span>\n                    {t('virtualTour')} {index + 1}\n                  </span>\n                </button>\n              </div>\n            </article>\n          );\n        })}\n      </div>\n\n      {/* Modal */}\n      {openIndex !== null && pannellumViewer && panoramas[openIndex] && (\n        <div\n          className={styles.modalOverlay}\n          onClick={() => setOpenIndex(null)}\n          role=\"dialog\"\n          aria-modal=\"true\"\n          aria-label={t('virtualTour')}\n        >\n          <div className={styles.modal} onClick={(e) => e.stopPropagation()}>\n            <button\n              className={styles.modalClose}\n              onClick={() => setOpenIndex(null)}\n              aria-label={locale === 'es' ? 'Cerrar tour 360°' : 'Close 360° tour'}\n            >\n              <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\">\n                <path d=\"M18 6L6 18M6 6l12 12\" />\n              </svg>\n            </button>\n            <div className={styles.modalContent} ref={viewerRef} />\n          </div>\n        </div>\n      )}\n    </section>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/home/diego/Documentos/jf-propiedad-raiz-web/packages/client/src/components/catalog/PropertyCard.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'ReactElement' is defined but never used.","line":13,"column":17,"nodeType":"Identifier","messageId":"unusedVar","endLine":13,"endColumn":29,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"ReactElement"},"fix":{"range":[366,384],"text":""},"desc":"Remove unused variable \"ReactElement\"."}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import Image from 'next/image';\nimport { useTranslations } from 'next-intl';\nimport type { PropertyCard } from '@jf/shared-types';\nimport { isNewProperty } from '@/mocks/property-mock';\nimport { buildWhatsAppUrl } from '@/lib/whatsapp';\nimport {\n  formatPrice,\n  getOperacionLabel,\n  buildWhatsAppMessage,\n  renderSpecs,\n} from './property-card-utils';\n\nimport React, { ReactElement } from 'react';\nimport styles from './PropertyCard.module.css';\n\ninterface PropertyCardProps {\n  readonly property: PropertyCard;\n  readonly locale: 'es' | 'en';\n}\n\nexport function PropertyCardComponent({ property, locale }: PropertyCardProps) {\n  const t = useTranslations('property');\n  const isNew = isNewProperty(property.createdAt);\n\n  const portada = property.portada?.[1]?.clave || property.portada?.[0]?.clave;\n  const sizes = '(max-width: 375px) 100vw, (max-width: 768px) 50vw, (max-width: 1024px) 33vw, 25vw';\n\n  const price = formatPrice(property.precio, locale);\n  const operacionLabel = getOperacionLabel(property.operacion, locale);\n  const titulo = property.titulo[locale] ?? property.titulo.es ?? '';\n  const codigo = property.codigo ?? '';\n\n  // WhatsApp URL for the card (US2.5, AC2.5.1, AC2.5.2)\n  const whatsappUrl = buildWhatsAppUrl({\n    number: process.env.NEXT_PUBLIC_WHATSAPP_NUMBER || '+573000000000',\n    message: buildWhatsAppMessage(t, property, locale),\n    isMobile: /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(\n      typeof navigator !== 'undefined' ? navigator.userAgent : '',\n    ),\n  });\n\n  return (\n    <article className={styles.card}>\n      {isNew && (\n        <div className={styles.newBadge}>\n          {locale === 'es' ? 'Nuevo' : 'New'}\n        </div>\n      )}\n\n      <div className={styles.imageContainer}>\n        {portada ? (\n          <Image\n            src={`/${portada}`}\n            alt={titulo}\n            fill\n            sizes={sizes}\n            className={styles.image}\n            loading=\"lazy\"\n            placeholder=\"blur\"\n            blurDataURL=\"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg==\"\n          />\n        ) : (\n          <div className={styles.imagePlaceholder}>\n            <span className={styles.placeholderIcon}>🏠</span>\n          </div>\n        )}\n\n        {property.destacada && (\n          <div className={styles.featuredBadge}>\n            {locale === 'es' ? 'Destacada' : 'Featured'}\n          </div>\n        )}\n      </div>\n\n      <div className={styles.content}>\n        <div className={styles.headerRow}>\n          <span className={styles.operationTag}>{operacionLabel}</span>\n          <span className={styles.code}>{codigo}</span>\n        </div>\n\n        <h3 className={styles.title} style={{ WebkitLineClamp: 1 }}>\n          {titulo}\n        </h3>\n\n        <p className={styles.price}>{price}</p>\n\n        {renderSpecs(property)}\n\n        <div className={styles.actions}>\n          <a\n            href={`/${locale}/propiedad/${property.slug}`}\n            className={styles.detailsLink}\n          >\n            {t('details')}\n          </a>\n          <a\n            href={whatsappUrl}\n            className={styles.whatsappLink}\n            target=\"_blank\"\n            rel=\"noopener noreferrer\"\n            aria-label={t('contactAgent')}\n          >\n            <span className={styles.whatsappIcon}>📱</span>\n            {t('contactAgent')}\n          </a>\n        </div>\n      </div>\n    </article>\n  );\n}\n","usedDeprecatedRules":[]},{"filePat