xpect(screen.getByText('Colegio San José')).toBeInTheDocument();\n    expect(screen.getByText('Metro Industriales')).toBeInTheDocument();\n    expect(screen.getByText('Zona comercial')).toBeInTheDocument();\n    expect(screen.getByText('Mi lugar favorito')).toBeInTheDocument();\n  });\n\n  it('usa etiqueta personalizada cuando existe', () => {\n    render(<PropertyPOIs puntosInteres={mockPOIs} locale=\"es\" />);\n    expect(screen.getByText('Mi lugar favorito')).toBeInTheDocument();\n  });\n\n  it('usa etiqueta genérica por categoría cuando no hay personalizada', () => {\n    render(<PropertyPOIs puntosInteres={mockPOIs} locale=\"es\" />);\n    expect(screen.getByText('Zona comercial')).toBeInTheDocument();\n  });\n\n  it('usa inglés cuando locale es en', () => {\n    setLocale('en');\n    render(<PropertyPOIs puntosInteres={mockPOIs} locale=\"en\" />);\n    expect(screen.getByText('San José School')).toBeInTheDocument();\n    expect(screen.getByText('Industriales Metro')).toBeInTheDocument();\n    expect(screen.getByText('Commercial area')).toBeInTheDocument();\n    expect(screen.getByText('My favorite place')).toBeInTheDocument();\n  });\n\n  it('no renderiza nada si array vacío', () => {\n    render(<PropertyPOIs puntosInteres={[]} locale=\"es\" />);\n    expect(screen.queryByText('Puntos de interés')).not.toBeInTheDocument();\n  });\n\n  it('no renderiza nada si array undefined', () => {\n    render(<PropertyPOIs puntosInteres={undefined} locale=\"es\" />);\n    expect(screen.queryByText('Puntos de interés')).not.toBeInTheDocument();\n  });\n});\n","usedDeprecatedRules":[]},{"filePath":"/home/diego/Documentos/jf-propiedad-raiz-web/packages/client/src/components/catalog/PropertyPOIs.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/home/diego/Documentos/jf-propiedad-raiz-web/packages/client/src/components/catalog/PropertySpecs.test.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'vi' is defined but never used.","line":1,"column":32,"nodeType":"Identifier","messageId":"unusedVar","endLine":1,"endColumn":34,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"vi"},"fix":{"range":[29,33],"text":""},"desc":"Remove unused variable \"vi\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'PropertyDetail' is defined but never used.","line":4,"column":15,"nodeType":"Identifier","messageId":"unusedVar","endLine":4,"endColumn":29,"suggestions":[{"messageId":"removeUnusedImportDeclaration","data":{"varName":"PropertyDetail"},"fix":{"range":[169,225],"text":""},"desc":"Remove unused import declaration."}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { describe, it, expect, vi, beforeEach } from 'vitest';\nimport { render, screen } from '@testing-library/react';\nimport { PropertySpecs } from './PropertySpecs';\nimport type { PropertyDetail } from '@jf/shared-types';\nimport { setLocale } from '../../test/setup';\n\nconst mockProperty = {\n  areaConstruida: 280,\n  areaLote: 1200,\n  dormitorios: 4,\n  banos: 3,\n  parqueaderos: 2,\n  estrato: 5,\n  antiguedad: '10',\n  administracion: '450000',\n  predial: '2500000',\n  acabados: {\n    es: 'Pisos en porcelanato, cocina integral',\n    en: 'Porcelain floors, integral kitchen',\n  },\n} as const;\n\ndescribe('PropertySpecs', () => {\n  beforeEach(() => {\n    setLocale('es');\n  });\n\n  it('renderiza título de sección', () => {\n    render(<PropertySpecs property={mockProperty} locale=\"es\" />);\n    expect(screen.getByText('Características')).toBeInTheDocument();\n  });\n\n  it('renderiza área construida con unidad m²', () => {\n    const { container } = render(<PropertySpecs property={mockProperty} locale=\"es\" />);\n    expect(container.textContent).toContain('280 m²');\n  });\n\n  it('renderiza área de lote con unidad m²', () => {\n    const { container } = render(<PropertySpecs property={mockProperty} locale=\"es\" />);\n    expect(container.textContent).toContain('1.200 m²');\n  });\n\n  it('renderiza dormitorios', () => {\n    render(<PropertySpecs property={mockProperty} locale=\"es\" />);\n    expect(screen.getByText('4')).toBeInTheDocument();\n  });\n\n  it('renderiza baños', () => {\n    render(<PropertySpecs property={mockProperty} locale=\"es\" />);\n    expect(screen.getByText('3')).toBeInTheDocument();\n  });\n\n  it('renderiza parqueaderos', () => {\n    render(<PropertySpecs property={mockProperty} locale=\"es\" />);\n    expect(screen.getByText('2')).toBeInTheDocument();\n  });\n\n  it('renderiza estrato', () => {\n    render(<PropertySpecs property={mockProperty} locale=\"es\" />);\n    expect(screen.getByText('5')).toBeInTheDocument();\n  });\n\n  it('renderiza antigüedad con unidad años', () => {\n    const { container } = render(<PropertySpecs property={mockProperty} locale=\"es\" />);\n    expect(container.textContent).toContain('10 años');\n  });\n\n  it('renderiza administración formateada en COP', () => {\n    render(<PropertySpecs property={mockProperty} locale=\"es\" />);\n    expect(screen.getByText(/\\$ 450\\.000/)).toBeInTheDocument();\n  });\n\n  it('renderiza predial formateado en COP', () => {\n    render(<PropertySpecs property={mockProperty} locale=\"es\" />);\n    expect(screen.getByText(/\\$ 2\\.500\\.000/)).toBeInTheDocument();\n  });\n\n  it('renderiza acabados', () => {\n    render(<PropertySpecs property={mockProperty} locale=\"es\" />);\n    expect(screen.getByText('Pisos en porcelanato, cocina integral')).toBeInTheDocument();\n  });\n\n  it('omite campos undefined', () => {\n    const partialProperty = { ...mockProperty, areaLote: undefined, parqueaderos: undefined };\n    const { container } = render(<PropertySpecs property={partialProperty} locale=\"es\" />);\n    expect(container.textContent).not.toContain('1.200 m²');\n    expect(screen.queryByText('2')).not.toBeInTheDocument();\n  });\n\n  it('usa inglés cuando locale es en', () => {\n    setLocale('en');\n    render(<PropertySpecs property={mockProperty} locale=\"en\" />);\n    expect(screen.getByText('Built Area')).toBeInTheDocument();\n    expect(screen.getByText('Lot Area')).toBeInTheDocument();\n    expect(screen.getByText('Bedrooms')).toBeInTheDocument();\n    expect(screen.getByText('Bathrooms')).toBeInTheDocument();\n    expect(screen.getByText('Parking')).toBeInTheDocument();\n    expect(screen.getByText('Stratum')).toBeInTheDocument();\n    expect(screen.getByText('Age')).toBeInTheDocument();\n    expect(screen.getByText('Admin Fee')).toBeInTheDocument();\n    expect(screen.getByText('Property Tax')).toBeInTheDocument();\n    expect(screen.getByText('Finishes')).toBeInTheDocument();\n  });\n});\n","usedDeprecatedRules":[]},{"filePath":"/home/diego/Documentos/jf-propiedad-raiz-web/packages/client/src/components/catalog/PropertySpecs.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/home/diego/Documentos/jf-propiedad-raiz-web/packages/client/src/components/catalog/PropertyStickySidebar.test.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'vi' is defined but never used.","line":1,"column":32,"nodeType":"Identifier","messageId":"unusedVar","endLine":1,"endColumn":34,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"vi"},"fix":{"range":[29,33],"text":""},"desc":"Remove unused variable \"vi\"."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'PropertyDetail' is defined but never used.","line":4,"column":15,"nodeType":"Identifier","messageId":"unusedVar","endLine":4,"endColumn":29,"suggestions":[{"messageId":"removeUnusedImportDeclaration","data":{"varName":"PropertyDetail"},"fix":{"range":[185,241],"text":""},"desc":"Remove unused import declaration."}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { describe, it, expect, vi, beforeEach } from 'vitest';\nimport { render, screen } from '@testing-library/react';\nimport { PropertyStickySidebar } from './PropertyStickySidebar';\nimport type { PropertyDetail } from '@jf/shared-types';\nimport { setLocale } from '../../test/setup';\n\nconst mockProperty = {\n  codigo: 'JF-0001',\n  operacion: 'VENTA',\n  precio: 850000000,\n  administracion: '450000',\n  predial: '2500000',\n  titulo: { es: 'Casa Moderna en Laureles', en: 'Modern House in Laureles' },\n  slug: 'casa-moderna-laureles',\n} as const;\n\ndescribe('PropertyStickySidebar', () => {\n  beforeEach(() => {\n    setLocale('es');\n  });\n\n  it('renderiza precio formateado en COP', () => {\n    render(<PropertyStickySidebar property={mockProperty} locale=\"es\" />);\n    expect(screen.getByText(/\\$ 850.000.000/)).toBeInTheDocument();\n  });\n\n  it('renderiza etiqueta de operación', () => {\n    render(<PropertyStickySidebar property={mockProperty} locale=\"es\" />);\n    expect(screen.getByText('Venta')).toBeInTheDocument();\n  });\n\n  it('renderiza botón de WhatsApp con enlace correcto', () => {\n    render(<PropertyStickySidebar property={mockProperty} locale=\"es\" />);\n    const whatsappBtn = screen.getByRole('link', { name: /contactar agente/i });\n    const href = whatsappBtn.getAttribute('href') || '';\n    expect(href).toMatch(/(wa\\.me|web\\.whatsapp\\.com)/);\n    expect(whatsappBtn).toHaveAttribute('target', '_blank');\n    expect(whatsappBtn).toHaveAttribute('rel', 'noopener noreferrer');\n  });\n\n  it('renderiza administración si existe', () => {\n    render(<PropertyStickySidebar property={mockProperty} locale=\"es\" />);\n    expect(screen.getByText(/Administración/)).toBeInTheDocument();\n    expect(screen.getByText(/\\$ 450.000/)).toBeInTheDocument();\n  });\n\n  it('renderiza predial si existe', () => {\n    render(<PropertyStickySidebar property={mockProperty} locale=\"es\" />);\n    expect(screen.getByText(/Predial/)).toBeInTheDocument();\n    expect(screen.getByText(/\\$ 2\\.500\\.000/)).toBeInTheDocument();\n  });\n\n  it('usa inglés cuando locale es en', () => {\n    setLocale('en');\n    render(<PropertyStickySidebar property={mockProperty} locale=\"en\" />);\n    expect(screen.getByText('For Sale')).toBeInTheDocument();\n    expect(screen.getByText('Contact Agent')).toBeInTheDocument();\n  });\n\n  it('renderiza precio con / mes para ALQUILER', () => {\n    const rentalProperty = { ...mockProperty, operacion: 'ALQUILER' as const, precio: 4500000 };\n    render(<PropertyStickySidebar property={rentalProperty} locale=\"es\" />);\n    expect(screen.getByText(/\\$ 4.500.000/)).toBeInTheDocument();\n    expect(screen.getByText('/ mes')).toBeInTheDocument();\n  });\n\n  it('omite administración si no existe', () => {\n    const propertyNoAdmin = { ...mockProperty, administracion: undefined };\n    render(<PropertyStickySidebar property={propertyNoAdmin} locale=\"es\" />);\n    expect(screen.queryByText(/Administración/)).not.toBeInTheDocument();\n  });\n\n  it('omite predial si no existe', () => {\n    const propertyNoPredial = { ...mockProperty, predial: undefined };\n    render(<PropertyStickySidebar property={propertyNoPredial} locale=\"es\" />);\n    expect(screen.queryByText(/Predial/)).not.toBeInTheDocument();\n  });\n});\n","usedDeprecatedRules":[]},{"filePath":"/home/diego/Documentos/jf-propiedad-raiz-web/packages/client/src/components/catalog/PropertyStickySidebar.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/home/diego/Documentos/jf-propiedad-raiz-web/packages/client/src/components/catalog/QueryClientProvider.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/home/diego/Documentos/jf-propiedad-raiz-web/packages/client/src/components/catalog/VideoFacade.test.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'vi' is defined but never used.","line":1,"column":32,"nodeType":"Identifier","messageId":"unusedVar","endLine":1,"endColumn":34,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"vi"},"fix":{"range":[29,33],"text":""},"desc":"Remove unused variable \"vi\"."}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { describe, it, expect, vi } from 'vitest';\nimport { render, screen, fireEvent } from '@testing-library/react';\nimport { VideoFacade } from './VideoFacade';\n\nconst mockVideos = [\n  'https://www.youtube.com/watch?v=dQw4w9WgXcQ',\n  'https://youtu.be/abc123',\n  'https://www.youtube.com/embed/xyz789',\n];\n\ndescribe('VideoFacade', () => {\n  it('renderiza título de sección', () => {\n    render(<VideoFacade videos={mockVideos} locale=\"es\" />);\n    expect(screen.getByText('Videos')).toBeInTheDocument();\n  });\n\n  it('renderiza una card por video', () => {\n    render(<VideoFacade videos={mockVideos} locale=\"es\" />);\n    const cards = screen.getAllByRole('listitem');\n    expect(cards).toHaveLength(3);\n  });\n\n  it('renderiza thumbnails con imagen de YouTube', () => {\n    render(<VideoFacade videos={mockVideos} locale=\"es\" />);\n    const images = screen.getAllByAltText(/Videos \\d+/);\n    expect(images).toHaveLength(3);\n    images.forEach((img) => {\n      const src = img.getAttribute('src');\n      expect(src).toMatch(/https:\\/\\/img\\.youtube\\.com\\/vi\\/[^/]+\\/maxresdefault\\.jpg/);\n    });\n  });\n\n  it('no renderiza nada si array vacío', () => {\n    render(<VideoFacade videos={[]} locale=\"es\" />);\n    expect(screen.queryByText('Videos')).not.toBeInTheDocument();\n  });\n\n  it('abre modal al hacer click en play', () => {\n    render(<VideoFacade videos={mockVideos} locale=\"es\" />);\n    const playButtons = screen.getAllByRole('button', { name: /Videos \\d+/ });\n    fireEvent.click(playButtons[0]);\n    expect(screen.getByRole('dialog')).toBeInTheDocument();\n    expect(screen.getByTitle('Videos 1')).toBeInTheDocument();\n  });\n\n  it('cierra modal al hacer click en cerrar', () => {\n    render(<VideoFacade videos={mockVideos} locale=\"es\" />);\n    const playButtons = screen.getAllByRole('button', { name: /Videos \\d+/ });\n    fireEvent.click(playButtons[0]);\n    fireEvent.click(screen.getByLabelText(/cerrar video|close video/i));\n    expect(screen.queryByRole('dialog')).not.toBeInTheDocument();\n  });\n\n  it('cierra modal al hacer click en overlay', () => {\n    render(<VideoFacade videos={mockVideos} locale=\"es\" />);\n    const playButtons = screen.getAllByRole('button', { name: /Videos \\d+/ });\n    fireEvent.click(playButtons[0]);\n    fireEvent.click(screen.getByRole('dialog'));\n    expect(screen.queryByRole('dialog')).not.toBeInTheDocument();\n  });\n\n  it('no renderiza nada si array vacío', () => {\n    render(<VideoFacade videos={[]} locale=\"es\" />);\n    expect(screen.queryByText('Videos')).not.toBeInTheDocument();\n  });\n\n  it('usa inglés cuando locale es en', () => {\n    render(<VideoFacade videos={mockVideos} locale=\"en\" />);\n    expect(screen.getByText('Videos')).toBeInTheDocument();\n  });\n});\n","usedDeprecatedRules":[]},{"filePath":"/home/diego/Documentos/jf-propiedad-raiz-web/packages/client/src/components/catalog/VideoFacade.tsx","messages":[{"ruleId":"@next/next/no-img-element","severity":1,"message":"Using `<img>` could result in slower LCP and higher bandwidth. Consider using `<Image />` from `next/image` or a custom image loader to automatically optimize images. This may incur additional usage or cost from your provider. See: https://nextjs.org/docs/messages/no-img-element","line":47,"column":19,"nodeType":"JSXOpeningElement","endLine":54,"endColumn":21}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"'use client';\nimport { useState } from 'react';\nimport { useTranslations } from 'next-intl';\nimport type { VideoYouTube } from '@jf/shared-types';\nimport styles from './VideoFacade.module.css';\n\nfunction extractYouTubeId(url: string): string | null {\n  const patterns = [\n    /(?:youtube\\.com\\/watch\\?v=|youtu\\.be\\/|youtube\\.com\\/embed\\/)([^&\\n?#]+)/,\n    /youtube\\.com\\/v\\/([^&\\n?#]+)/,\n  ];\n  for (const pattern of patterns) {\n    const match = url.match(pattern);\n    if (match?.[1]) return match[1];\n  }\n  return null;\n}\n\ninterface VideoFacadeProps {\n  readonly videos: readonly VideoYouTube[];\n  readonly locale: 'es' | 'en';\n}\n\nexport function VideoFacade({ videos, locale }: VideoFacadeProps) {\n  const t = useTranslations('property');\n  const [openIndex, setOpenIndex] = useState<number | null>(null);\n\n  if (!videos || videos.length === 0) return null;\n\n  return (\n    <section className={styles.section} aria-labelledby={styles.titleId}>\n      <h2 id={styles.titleId} className={styles.title}>\n        {t('videos')}\n      </h2>\n      <div className={styles.grid} role=\"list\">\n        {videos.map((videoUrl, index) => {\n          const videoId = extractYouTubeId(videoUrl);\n          const thumbnailUrl = videoId\n            ? `https://img.youtube.com/vi/${videoId}/maxresdefault.jpg`\n            : '';\n          const titulo = `${t('videos')} ${index + 1}`;\n\n          return (\n            <article key={index} className={styles.card} role=\"listitem\">\n              {videoId && (\n                <div className={styles.thumbnailWrapper}>\n                  <img\n                    src={thumbnailUrl}\n                    alt={titulo}\n                    className={styles.thumbnail}\n                    loading=\"lazy\"\n                    width=\"640\"\n                    height=\"360\"\n                  />\n                  <button\n                    className={styles.playBtn}\n                    onClick={() => setOpenIndex(index)}\n                    aria-label={`${titulo}`}\n                  >\n                    <svg viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\">\n                      <path d=\"M8 5v14l11-7z\" />\n                    </svg>\n                  </button>\n                </div>\n              )}\n\n              <h3 className={styles.videoTitle}>{titulo}</h3>\n            </article>\n          );\n        })}\n      </div>\n\n      {/* Modal */}\n      {openIndex !== null && videos[openIndex] && (\n        <div\n          className={styles.modalOverlay}\n          onClick={() => setOpenIndex(null)}\n          role=\"dialog\"\n          aria-modal=\"true\"\n          aria-label={t('videos')}\n        >\n          <div className={styles.modal} onClick={(e) => e.stopPropagation()}>\n            <button\n              className={styles.modalClose}\n              onClick={() => setOpenIndex(null)}\n              aria-label={locale === 'es' ? 'Cerrar video' : 'Close video'}\n            >\n              <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" strokeWidth=\"2\">\n                <path d=\"M18 6L6 18M6 6l12 12\" />\n              </svg>\n            </button>\n            <div className={styles.modalContent}>\n              {(() => {\n                const videoId = extractYouTubeId(videos[openIndex]);\n                if (!videoId) return null;\n                return (\n                  <iframe\n                    title={`${t('videos')} ${openIndex + 1}`}\n                    src={`https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&rel=0`}\n                    allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\"\n                    allowFullScreen\n                    className={styles.iframe}\n                  />\n                );\n              })()}\n            </div>\n          </div>\n        </div>\n      )}\n    </section>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/home/diego/Documentos/jf-propiedad-raiz-web/packages/client/src/components/catalog/property-card-utils.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/home/diego/Documentos/jf-propiedad-raiz-web/packages/client/src/components/catalog/property-grid-hooks.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/home/diego/Documentos/jf-propiedad-raiz-web/packages/client/src/components/errors/ErrorBoundary.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/home/diego/Documentos/jf-propiedad-raiz-web/packages/client/src/i18n/config.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/home/diego/Documentos/jf-propiedad-raiz-web/packages/client/src/i18n/messages.parity.test.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/home/diego/Documentos/jf-propiedad-raiz-web/packages/client/src/i18n/messages.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/home/diego/Documentos/jf-propiedad-raiz-web/packages/client/src/i18n/negotiate.test.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/home/diego/Documentos/jf-propiedad-raiz-web/packages/client/src/i18n/negotiate.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/home/diego/Documentos/jf-propiedad-raiz-web/packages/client/src/i18n/request.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/home/diego/Documentos/jf-propiedad-raiz-web/packages/client/src/i18n/routes.test.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/home/diego/Documentos/jf-propiedad-raiz-web/packages/client/src/i18n/routes.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/home/diego/Documentos/jf-propiedad-raiz-web/packages/client/src/instrumentation.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/home/diego/Documentos/jf-propiedad-raiz-web/packages/client/src/lib/api-catalog.ts","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'operacion' is defined but never used.","line":81,"column":3,"nodeType":"Identifier","messageId":"unusedVar","endLine":81,"endColumn":12},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'locale' is defined but never used.","line":88,"column":3,"nodeType":"Identifier","messageId":"unusedVar","endLine":88,"endColumn":9}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { httpClient, type ApiResponse } from './http-client';\nimport type { IHttpClient } from './http-client.types';\nimport { HttpClientAdapter } from './http-client.types';\nimport type { PropertyCard, PropertyDetail } from '@jf/shared-types';\n\n/**\n * Cliente API para el catálogo público - consume BFF /api/properties\n * Maneja la paginación por cursor y la lógica de destacadas/no-destacadas\n */\n\nexport interface PropertyListParams {\n  readonly operacion: 'VENTA' | 'ALQUILER' | 'PROYECTO_SOBRE_PLANOS';\n  readonly destacada: boolean;\n  readonly tipo?: string | undefined;\n  readonly departamento?: string | undefined;\n  readonly municipio?: string | undefined;\n  readonly precioMin?: number | undefined;\n  readonly precioMax?: number | undefined;\n  readonly cursor?: string | undefined;\n  readonly limit?: number | undefined;\n}\n\nexport interface PropertyListData {\n  readonly items: readonly PropertyCard[];\n  readonly nextCursor: string | null;\n}\n\nexport interface ServiceCard {\n  readonly id: string;\n  readonly slug: string;\n  readonly titulo: import('@jf/shared-types').Translatable;\n  readonly resumen?: import('@jf/shared-types').Translatable;\n  readonly orden: number;\n  readonly portada?: {\n    readonly clavesPorAncho?: Record<string, string>;\n  };\n}\n\nexport interface AboutDocument {\n  readonly titulo: import('@jf/shared-types').Translatable;\n  readonly extracto: import('@jf/shared-types').Translatable;\n  readonly secciones: readonly {\n    readonly id: string;\n    readonly titulo: import('@jf/shared-types').Translatable;\n    readonly cuerpo: import('@jf/shared-types').Translatable;\n  }[];\n  readonly equipo: readonly {\n    readonly id: string;\n    readonly nombre: string;\n    readonly cargo: import('@jf/shared-types').Translatable;\n    readonly descripcion?: import('@jf/shared-types').Translatable;\n    readonly foto?: string;\n  }[];\n  readonly updatedAt: string;\n}\n\nfunction buildPropertiesUrl(params: PropertyListParams): string {\n  const searchParams = new URLSearchParams();\n  searchParams.set('operacion', params.operacion);\n  searchParams.set('destacada', String(params.destacada));\n  if (params.tipo) searchParams.set('tipo', params.tipo);\n  if (params.departamento) searchParams.set('departamento', params.departamento);\n  if (params.municipio) searchParams.set('municipio', params.municipio);\n  if (params.precioMin) searchParams.set('precioMin', String(params.precioMin));\n  if (params.precioMax) searchParams.set('precioMax', String(params.precioMax));\n  if (params.cursor) searchParams.set('cursor', params.cursor);\n  if (params.limit) searchParams.set('limit', String(params.limit));\n  return `/api/properties?${searchParams.toString()}`;\n}\n\nexport async function fetchPropertiesPage(\n  params: PropertyListParams,\n  httpClientInstance?: IHttpClient,\n): Promise<ApiResponse<PropertyListData>> {\n  const url = buildPropertiesUrl(params);\n  const client = httpClientInstance ?? new HttpClientAdapter();\n  return client.get<PropertyListData>(url);\n}\n\nexport async function fetchFeaturedProperties(\n  operacion: 'VENTA' | 'ALQUILER' | 'PROYECTO_SOBRE_PLANOS',\n): Promise<ApiResponse<{ items: readonly PropertyCard[] }>> {\n  return httpClient<{ items: readonly PropertyCard[] }>(`/api/properties/featured`);\n}\n\nexport async function fetchPropertyBySlug(\n  slug: string,\n  locale: 'es' | 'en',\n): Promise<ApiResponse<PropertyDetail>> {\n  return httpClient<PropertyDetail>(`/api/properties/${slug}`);\n}\n\nexport async function fetchServices(): Promise<ApiResponse<{ items: readonly ServiceCard[] }>> {\n  return httpClient<{ items: readonly ServiceCard[] }>(`/api/services`);\n}\n\nexport async function fetchAbout(): Promise<ApiResponse<AboutDocument>> {\n  return httpClient<AboutDocument>(`/api/about`);\n}\n","usedDeprecatedRules":[]},{"filePath":"/home/diego/Doc