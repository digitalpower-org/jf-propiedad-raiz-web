ber;\n    autoRotateInactivityDelay?: number;\n    hfov?: number;\n    minHfov?: number;\n    maxHfov?: number;\n    pitch?: number;\n    yaw?: number;\n    minPitch?: number;\n    maxPitch?: number;\n    minYaw?: number;\n    maxYaw?: number;\n    compass?: boolean;\n    northOffset?: number;\n    showControls?: boolean;\n    orientationOnByDefault?: boolean;\n    [key: string]: unknown;\n  }\n\n  interface Viewer {\n    destroy(): void;\n  }\n\n  const viewer: (container: HTMLElement, options: ViewerOptions) => { destroy: () => void };\n  export { viewer };\n  export default viewer;\n}\n","usedDeprecatedRules":[]},{"filePath":"/home/diego/Documentos/jf-propiedad-raiz-web/packages/client/vitest.config.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]}]