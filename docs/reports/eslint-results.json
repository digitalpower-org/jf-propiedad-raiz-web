5',\n    areaLote: 1000,\n    parqueaderos: 2,\n    deposito: 1,\n    amenidades: ['PISCINA', 'GIMNASIO', 'CANCHA'] as readonly Amenidad[],\n    puntosInteres: [\n      createPuntoInteres('EDUCACION', { es: 'Colegio San José', en: 'San José School' }),\n      createPuntoInteres('TRANSPORTE_PUBLICO', {\n        es: 'Estación Metro Industriales',\n        en: 'Industriales Metro Station',\n      }),\n      createPuntoInteres('ZONA_COMERCIAL', {\n        es: 'Centro Comercial Unicentro',\n        en: 'Unicentro Mall',\n      }),\n    ],\n    fotos: [\n      createFoto('propiedades/JF-0001/foto1', [320, 640, 1280, 2048]),\n      createFoto('propiedades/JF-0001/foto2', [320, 640, 1280, 2048]),\n      createFoto('propiedades/JF-0001/foto3', [320, 640, 1280, 2048]),\n    ],\n    videos: ['https://www.youtube.com/watch?v=example1'] as const,\n    panoramas: [{ derivados: createDerivados('propiedades/JF-0001/panorama1', [4096]) }] as const,\n    fechaPublicacion: '2024-12-01',\n  };\n}\n\nexport function isNewProperty(createdAt: string): boolean {\n  const NEW_PROPERTY_DAYS = Number(process.env.NEW_PROPERTY_DAYS) || 30;\n  const created = new Date(createdAt);\n  const now = new Date();\n  const diffDays = Math.floor((now.getTime() - created.getTime()) / (1000 * 60 * 60 * 24));\n  return diffDays < NEW_PROPERTY_DAYS;\n}\n","usedDeprecatedRules":[]},{"filePath":"/home/diego/Documentos/jf-propiedad-raiz-web/packages/client/src/proxy.test.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/home/diego/Documentos/jf-propiedad-raiz-web/packages/client/src/proxy.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/home/diego/Documentos/jf-propiedad-raiz-web/packages/client/src/server/backend-url.test.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/home/diego/Documentos/jf-propiedad-raiz-web/packages/client/src/server/backend-url.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/home/diego/Documentos/jf-propiedad-raiz-web/packages/client/src/server/bff-delegation.test.ts","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'_req' is defined but never used.","line":144,"column":39,"nodeType":"Identifier","messageId":"unusedVar","endLine":144,"endColumn":43},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'_ctx' is defined but never used.","line":144,"column":45,"nodeType":"Identifier","messageId":"unusedVar","endLine":144,"endColumn":49}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\n * MT1.1 — BFF y seguridad interna (AC1.3.1, AC1.3.2, AC1.3.5, AC1.3.6).\n *\n * Verifica que:\n * 1. Toda ruta con internalPath reenvía a functionsBaseUrl con X-Internal-Key\n *    correcto y sin reenviar cookie/authorization del cliente (AC1.3.2, AC1.3.5).\n * 2. Toda ruta con auth: 'session' responde 401 sin llamar al backend cuando\n *    no hay cookie válida (AC1.3.1).\n * 3. Toda ruta con auth: 'internal' exige X-Internal-Key válida (AC1.3.6).\n */\n\nimport { NextRequest, NextResponse } from 'next/server';\nimport { afterEach, beforeAll, beforeEach, describe, expect, it, test, vi } from 'vitest';\n\nimport { ROUTES } from './routes';\n\nvi.mock('server-only', () => ({ default: undefined }));\n\nconst INTERNAL_KEY = 'test-key-with-at-least-32-chars!!!';\nconst SECRET = 'test-secret-with-at-least-32-chars!!!';\n\nbeforeAll(() => {\n  process.env.BFF_INTERNAL_KEY = INTERNAL_KEY;\n  process.env.SESSION_JWT_SECRET = SECRET;\n  process.env.SESSION_JWT_SECRET_PREVIOUS = '';\n  process.env.SESSION_TTL = '3900';\n  process.env.SESSION_SKEW = '60';\n  process.env.FUNCTIONS_BASE_URL = 'https://functions.test';\n});\n\nbeforeEach(() => {\n  vi.spyOn(console, 'warn').mockImplementation(() => {});\n});\n\nafterEach(() => {\n  vi.unstubAllGlobals();\n  vi.restoreAllMocks();\n});\n\nasync function load() {\n  vi.resetModules();\n  const { bffRoute } = await import('./bff-helper');\n  const { signSession } = await import('./session/jwt');\n  const { delegateToBackend } = await import('./bff-helper');\n  return { bffRoute, delegateToBackend, jwt: { signSession } };\n}\n\nfunction request(\n  pathname: string,\n  init: { method?: string; headers?: Record<string, string>; body?: string } = {},\n): NextRequest {\n  const reqInit: RequestInit = {\n    method: init.method ?? 'GET',\n    headers: init.headers ?? {},\n  };\n  if (init.body !== undefined) {\n    reqInit.body = init.body;\n  }\n  // @ts-expect-error - NextRequest espera un RequestInit estricto.\n  return new NextRequest(`http://localhost:3001${pathname}`, reqInit);\n}\n\nfunction upstreamFactory() {\n  return () =>\n    new Response(JSON.stringify({ success: true, data: null, message: 'ok' }), {\n      status: 200,\n      headers: { 'content-type': 'application/json' },\n    });\n}\n\nfunction validCookie(jwtModule: {\n  signSession: (claims: { sub: string; email: string; role: string }) => string;\n}): string {\n  const token = jwtModule.signSession({ sub: 'uid-1', email: 'admin@test.local', role: 'admin' });\n  return `__session=${token}`;\n}\n\nconst delegableRoutes = ROUTES.filter((route) => route.internalPath !== null);\n\ndescribe('MT1.1 — delegateToBackend con rutas internalPath', () => {\n  test.each(delegableRoutes)(\n    'delega $path al backend con X-Internal-Key y sin reenviar cookie/authorization',\n    async (route: (typeof ROUTES)[number]) => {\n      const { bffRoute, delegateToBackend, jwt } = await load();\n      const fetchMock = vi.fn().mockImplementation(upstreamFactory());\n      vi.stubGlobal('fetch', fetchMock);\n\n      const handler = bffRoute((req, ctx) => delegateToBackend(req, ctx));\n      const cookieValue = validCookie(jwt);\n\n      await handler(\n        request(route.path, {\n          method: route.method,\n          headers: {\n            cookie: cookieValue,\n            authorization: 'Bearer forged-id-token',\n            'x-user-id': 'attacker',\n          },\n        }),\n        {},\n      );\n\n      const call = fetchMock.mock.calls[0];\n      expect(call).toBeDefined();\n      expect(String(call?.[0])).toContain((route.internalPath ?? '').replace('{idOrSlug}', ''));\n\n      const headers = new Headers(call?.[1]?.headers);\n      expect(headers.get('x-internal-key')).toBe(INTERNAL_KEY);\n      expect(headers.get('cookie')).toBeNull();\n      expect(headers.get('authorization')).toBeNull();\n    },\n  );\n});\n\ndescribe('MT1.1 — Guard de sesión (401 sin llamar al backend)', () => {\n  it(`rechaza las rutas session con 401 sin llamar al backend (AC1.3.1)`, async () => {\n    const { bffRoute, delegateToBackend } = await load();\n    const fetchMock = vi.fn();\n    vi.stubGlobal('fetch', fetchMock);\n\n    const sessionRoutes = ROUTES.filter((route) => route.auth === 'session');\n\n    for (const route of sessionRoutes) {\n      const handler = bffRoute((req, ctx) => delegateToBackend(req, ctx));\n      const response = await handler(request(route.path, { method: route.method }), {});\n\n      expect(response.status).toBe(401);\n      const body = await response.json();\n      expect(body.success).toBe(false);\n      expect(body.data.code).toBe('UNAUTHORIZED');\n    }\n\n    expect(fetchMock).not.toHaveBeenCalled();\n  });\n});\n\ndescribe('MT1.1 — Política internal (AC1.3.6)', () => {\n  it(`exige X-Internal-Key en rutas internal`, async () => {\n    const { bffRoute } = await load();\n\n    const internalRoutes = ROUTES.filter((route) => route.auth === 'internal');\n\n    for (const route of internalRoutes) {\n      const handler = bffRoute(async (_req, _ctx) => {\n        return new NextResponse(JSON.stringify({ ok: true }), { status: 200 });\n      });\n\n      // Sin X-Internal-Key → 401\n      const response = await handler(request(route.path, { method: route.method }), {});\n      expect(response.status).toBe(401);\n      const body = await response.json();\n      expect(body.success).toBe(false);\n      expect(body.data.code).toBe('UNAUTHORIZED');\n\n      // Con X-Internal-Key válida → ejecuta handler (200)\n      const responseOk = await handler(\n        request(route.path, {\n          method: route.method,\n          headers: { 'x-internal-key': INTERNAL_KEY },\n        }),\n        {},\n      );\n      expect(responseOk.status).toBe(200);\n    }\n  });\n});\n","usedDeprecatedRules":[]},{"filePath":"/home/diego/Documentos/jf-propiedad-raiz-web/packages/client/src/server/bff-helper.test.ts","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'RequestInitLike' is defined but never used.","line":42,"column":6,"nodeType":"Identifier","messageId":"unusedVar","endLine":42,"endColumn":21}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\n * US1.3 — Envoltorio del BFF: política de sesión y propagación de identidad.\n *\n * Cubre AC1.3.1 (401 sin llamar al backend), AC1.3.2/AC1.3.5 (identidad solo\n * desde el JWT verificado, sin confiar en `X-User-*`, `cookie` ni\n * `authorization` del cliente), AC1.3.6 (X-Internal-Key) y AC1.3.7 (no-store).\n */\n\nimport { NextRequest } from 'next/server';\nimport { afterEach, beforeAll, beforeEach, describe, expect, it, vi } from 'vitest';\n\nvi.mock('server-only', () => ({ default: undefined }));\n\nconst INTERNAL_KEY = 'test-key-with-at-least-32-chars!!!';\nconst SECRET = 'test-secret-with-at-least-32-chars!!!';\n\nbeforeAll(() => {\n  process.env.BFF_INTERNAL_KEY = INTERNAL_KEY;\n  process.env.SESSION_JWT_SECRET = SECRET;\n  process.env.SESSION_JWT_SECRET_PREVIOUS = '';\n  process.env.SESSION_TTL = '3900';\n  process.env.SESSION_SKEW = '60';\n  process.env.FUNCTIONS_BASE_URL = 'https://functions.test';\n});\n\nbeforeEach(() => {\n  vi.spyOn(console, 'warn').mockImplementation(() => {});\n});\n\nafterEach(() => {\n  vi.unstubAllGlobals();\n  vi.restoreAllMocks();\n});\n\nasync function load() {\n  vi.resetModules();\n  const helper = await import('./bff-helper');\n  const jwt = await import('./session/jwt');\n  return { helper, jwt };\n}\n\ntype RequestInitLike = {\n  method?: string;\n  headers?: Record<string, string>;\n  body?: string;\n};\n\nfunction request(\n  pathname: string,\n  init: { method?: string; headers?: Record<string, string>; body?: string } = {},\n): NextRequest {\n  const reqInit: RequestInit = {\n    method: init.method ?? 'GET',\n    headers: init.headers ?? {},\n  };\n  if (init.body !== undefined) {\n    reqInit.body = init.body;\n  }\n  // @ts-expect-error - NextRequest espera un RequestInit estricto,\n  // pero el objeto cumple con lo necesario para pruebas.\n  return new NextRequest(`http://localhost:3001${pathname}`, reqInit);\n}\n\nfunction upstream(payload: unknown = { success: true, data: null, message: 'ok' }, status = 200) {\n  return new Response(JSON.stringify(payload), {\n    status,\n    headers: { 'content-type': 'application/json' },\n  });\n}\n\nfunction validCookie(jwt: {\n  signSession: (claims: { sub: string; email: string; role: string }) => string;\n}): string {\n  const token = jwt.signSession({ sub: 'uid-1', email: 'admin@test.local', role: 'admin' });\n  return `__session=${token}`;\n}\n\nfunction forwardedHeaders(fetchMock: ReturnType<typeof vi.fn>): Headers {\n  const call = fetchMock.mock.calls[0];\n  if (!call) throw new Error('No se llamó al backend');\n  return new Headers(call[1]?.headers);\n}\n\ndescribe('bffRoute — política de sesión', () => {\n  it('sin cookie responde 401 con la envoltura de error y no llama al backend (AC1.3.1, AC0.1.2)', async () => {\n    const { helper } = await load();\n    const fetchMock = vi.fn();\n    vi.stubGlobal('fetch', fetchMock);\n\n    const handler = helper.bffRoute((req, ctx) => helper.delegateToBackend(req, ctx));\n    const response = await handler(request('/api/properties', { method: 'POST', body: '{}' }), {});\n    const body = await response.json();\n\n    expect(response.status).toBe(401);\n    expect(body.success).toBe(false);\n    expect(body.data.code).toBe('UNAUTHORIZED');\n    expect(body.data.details).toEqual([]);\n    expect(typeof body.data.requestId).toBe('string');\n    expect(typeof body.message).toBe('string');\n    expect(fetchMock).not.toHaveBeenCalled();\n  });\n\n  it('rechaza una cookie malformada sin llamar al backend', async () => {\n    const { helper } = await load();\n    const fetchMock = vi.fn();\n    vi.stubGlobal('fetch', fetchMock);\n\n    const handler = helper.bffRoute((req, ctx) => helper.delegateToBackend(req, ctx));\n    const response = await handler(\n      request('/api/properties', {\n        method: 'POST',\n        headers: { cookie: '__session=basura' },\n        body: '{}',\n      }),\n      {},\n    );\n\n    expect(response.status).toBe(401);\n    expect(fetchMock).not.toHaveBeenCalled();\n  });\n\n  it('propaga la identidad del JWT y descarta X-User-*, cookie y authorization del cliente (AC1.3.2, AC1.3.5)', async () => {\n    const { helper, jwt } = await load();\n    const fetchMock = vi.fn().mockResolvedValue(upstream());\n    vi.stubGlobal('fetch', fetchMock);\n\n    const handler = helper.bffRoute((req, ctx) => helper.delegateToBackend(req, ctx));\n    const response = await handler(\n      request('/api/properties', {\n        method: 'POST',\n        headers: {\n          'content-type': 'application/json',\n          cookie: validCookie(jwt),\n          authorization: 'Bearer forged-id-token',\n          'x-user-id': 'attacker',\n          'x-user-email': 'attacker@evil.test',\n          'x-user-role': 'admin',\n          'x-internal-key': 'forged-key-with-at-least-32-chars',\n        },\n        body: '{\"title\":\"Casa\"}',\n      }),\n      {},\n    );\n\n    const call = fetchMock.mock.calls[0];\n    expect(call?.[0]).toBe('https://functions.test/api/api/v1/properties');\n\n    const headers = forwardedHeaders(fetchMock);\n    expect(headers.get('x-internal-key')).toBe(INTERNAL_KEY);\n    expect(headers.get('x-user-id')).toBe('uid-1');\n    expect(headers.get('x-user-email')).toBe('admin@test.local');\n    expect(headers.get('x-user-role')).toBe('admin');\n    expect(headers.get('cookie')).toBeNull();\n    expect(headers.get('authorization')).toBeNull();\n    expect(headers.get('content-type')).toBe('application/json');\n    expect(response.headers.get('cache-control')).toBe('no-store');\n  });\n\n  it('una ruta public no lee la cookie ni propaga identidad ni no-store (AC1.3.7)', async () => {\n    const { helper, jwt } = await load();\n    const fetchMock = vi.fn().mockResolvedValue(upstream());\n    vi.stubGlobal('fetch', fetchMock);\n\n    const handler = helper.bffRoute((req, ctx) => helper.delegateToBackend(req, ctx));\n    const response = await handler(\n      request('/api/properties', {\n        headers: {\n          cookie: validCookie(jwt),\n          'x-user-id': 'attacker',\n          'x-user-role': 'admin',\n        },\n      }),\n      {},\n    );\n\n    const headers = forwardedHeaders(fetchMock);\n    expect(headers.get('x-user-id')).toBeNull();\n    expect(headers.get('x-user-email')).toBeNull();\n    expect(headers.get('x-user-role')).toBeNull();\n    expect(response.headers.get('cache-control')).toBeNull();\n  });\n\n  it('sustituye y codifica el segmento dinámico del catálogo', async () => {\n    const { helper } = await load();\n    const fetchMock = vi.fn().mockResolvedValue(upstream());\n    vi.stubGlobal('fetch', fetchMock);\n\n    const handler = helper.bffRoute(\n      async (req, ctx, { params }: { params: Promise<{ idOrSlug: string }> }) => {\n        const { idOrSlug } = await params;\n        return helper.delegateToBackend(req, ctx, { idOrSlug });\n      },\n    );\n    await handler(request('/api/properties/casa-arboleda'), {\n      params: Promise.resolve({ idOrSlug: 'casa arbórea' }),\n    });\n\n    expect(fetchMock.mock.calls[0]?.[0]).toBe(\n      'https://functions.test/api/api/v1/properties/casa%20arb%C3%B3rea',\n    );\n  });\n\n  it('propaga el 204 del backend sin cuerpo', async () => {\n    const { helper, jwt } = await load();\n    vi.stubGlobal('fetch', vi.fn().mockResolvedValue(new Response(null, { status: 204 })));\n\n    const handler = helper.bffRoute((req, ctx) => helper.delegateToBackend(req, ctx));\n    const response = await handler(\n      request('/api/properties/casa-1', {\n        method: 'DELETE',\n        headers: { cookie: validCookie(jwt) },\n      }),\n      {},\n    );\n\n    expect(response.status).toBe(204);\n    expect(await response.text()).toBe('');\n  });\n\n  it('ignora X-User-Role spoofeado cuando no hay cookie válida: 401 sin llamar al backend (AC1.3.5)', async () => {\n    const { helper } = await load();\n    const fetchMock = vi.fn();\n    vi.stubGlobal('fetch', fetchMock);\n\n    const handler = helper.bffRoute((req, ctx) => helper.delegateToBackend(req, ctx));\n    const response = await handler(\n      request('/api/properties', {\n        method: 'POST',\n        headers: {\n          'content-type': 'application/json',\n          'x-user-id': 'attacker',\n          'x-user-email': 'attacker@evil.test',\n          'x-user-role': 'admin',\n        },\n        body: '{\"title\":\"Casa\"}',\n      }),\n      {},\n    );\n\n    const body = await response.json();\n\n    expect(response.status).toBe(401);\n    expect(body.success).toBe(false);\n    expect(body.data.code).toBe('UNAUTHORIZED');\n    expect(fetchMock).not.toHaveBeenCalled();\n  });\n});\n\ndescribe('bffRoute — política internal (AC1.3.6)', () => {\n  it('sin X-Internal-Key responde 401 antes de ejecutar el handler', async () => {\n    const { helper } = await load();\n    const inner = vi.fn().mockResolvedValue(helper.envelope({ ok: true }));\n\n    const handler = helper.bffRoute(inner);\n    const response = await handler(request('/api/revalidate', { method: 'POST', body: '{}' }), {});\n\n    expect(response.status).toBe(401);\n    expect(inner).not.toHaveBeenCalled();\n  });\n\n  it('con X-Internal-Key válida ejecuta el handler', async () => {\n    const { helper } = await load();\n    const inner = vi.fn().mockResolvedValue(helper.envelope({ ok: true }));\n\n    const handler = helper.bffRoute(inner);\n    const response = await handler(\n      request('/api/revalidate', {\n        method: 'POST',\n        headers: { 'x-internal-key': INTERNAL_KEY },\n        body: '{}',\n      }),\n      {},\n    );\n\n    expect(response.status).toBe(200);\n    expect(inner).toHaveBeenCalledTimes(1);\n  });\n});\n","usedDeprecatedRules":[]},{"filePath":"/home/diego/Documentos/jf-propiedad-raiz-web/packages/client/src/server/bff-helper.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/home/diego/Documentos/jf-propiedad-raiz-web/packages/client/src/server/config/server-config.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/home/diego/Documentos/jf-propiedad-raiz-web/packages/client/src/server/health.test.ts","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'originalFetch' is assigned a value but never used.","line":44,"column":9,"nodeType":"Identifier","messageId":"unusedVar","endLine":44,"endColumn":22}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\n * MT1.1 — Tests de lógica pura de health check (BFF + Functions).\n *\n * Ejecutar: npm run test (desde packages/client)\n */\n\nimport { describe, it, expect, vi, beforeEach, afterEach, beforeAll, afterAll } from 'vitest';\n\n// server-only lanza al importarse fuera de Server Component de Next.js.\n// En Vitest (entorno Node) se mockea como no-op para que no rompa los tests puros.\nvi.mock('server-only', () => ({ default: undefined }));\n\nconst originalEnv = process.env.FUNCTIONS_BASE_URL;\n\n// server-config hace Zod parse() en nivel de módulo: requiere BFF_INTERNAL_KEY\n// y SESSION_JWT_SECRET definidos ANTES de importar ./health.\nbeforeAll(() => {\n  process.env.BFF_INTERNAL_KEY = 'test-key-with-at-least-32-chars!!!';\n  process.env.SESSION_JWT_SECRET = 'test-secret-with-at-least-32-chars!!!';\n});\n\nafterAll(() => {\n  if (originalEnv !== undefined) {\n    process.env.FUNCTIONS_BASE_URL = originalEnv;\n  } else {\n    delete process.env.FUNCTIONS_BASE_URL;\n  }\n});\n\nasync function importHealth() {\n  vi.resetModules();\n  return await import('./health');\n}\n\nasync function importConfig() {\n  vi.resetModules();\n  return await import('./config/server-config');\n}\n\ntype HealthModule = Awaited<ReturnType<typeof importHealth>>;\n\ndescribe('health — lógica pura', () => {\n  // Mock global de fetch\n  const originalFetch = globalThis.fetch;\n\n  let health: HealthModule;\n  let config: Awaited<ReturnType<typeof importConfig>>;\n\n  beforeEach(async () => {\n    vi.stubGlobal('fetch', vi.fn());\n    delete process.env.FUNCTIONS_BASE_URL;\n    health = await importHealth();\n    config = await importConfig();\n  });\n\n  afterEach(() => {\n    vi.unstubAllGlobals();\n    delete process.env.FUNCTIONS_BASE_URL;\n  });\n\n  describe('functionsBaseUrl', () => {\n    it('usa default cuando no hay FUNCTIONS_BASE_URL', () => {\n      expect(config.functionsBaseUrl).toBe('http://127.0.0.1:5001/jf-propiedad-raiz/us-central1');\n    });\n\n    it('usa FUNCTIONS_BASE_URL cuando existe', async () => {\n      process.env.FUNCTIONS_BASE_URL = 'https://custom.example.com/functions';\n      config = await importConfig();\n      expect(config.functionsBaseUrl).toBe('https://custom.example.com/functions');\n    });\n  });\n\n  describe('checkFunctionsHealth', () => {\n    const makeResponse = (\n      overrides: Partial<{\n        ok: boolean;\n        status: number;\n        json: unknown;\n      }> = {},\n    ) => ({\n      ok: overrides.ok ?? true,\n      status: overrides.status ?? 200,\n      json: vi.fn().mockResolvedValue(overrides.json ?? { status: 'ok', service: 'functions' }),\n    });\n\n    it('resuelve ok con respuesta 200 + status ok', async () => {\n      const mockFetch = vi.fn().mockResolvedValue(makeResponse());\n      vi.stubGlobal('fetch', mockFetch);\n\n      const result = await health.checkFunctionsHealth();\n\n      expect(result.status).toBe('ok');\n      expect(result.service).toBe('functions');\n      expect(result.latencyMs).toBeDefined();\n      expect(result.latencyMs).toBeGreaterThanOrEqual(0);\n      expect(result.error).toBeUndefined();\n    });\n\n    it('resuelve error con HTTP 500', async () => {\n      const mockFetch = vi.fn().mockResolvedValue(makeResponse({ ok: false, status: 500 }));\n      vi.stubGlobal('fetch', mockFetch);\n\n      const result = await health.checkFunctionsHealth();\n\n      expect(result.status).toBe('error');\n      expect(result.service).toBe('functions');\n      expect(result.latencyMs).toBeDefined();\n      expect(result.error).toContain('HTTP 500');\n    });\n\n    it('resuelve error con HTTP 200 pero status no ok', async () => {\n      const mockFetch = vi\n        .fn()\n        .mockResolvedValue(makeResponse({ json: { status: 'degraded', service: 'functions' } }));\n      vi.stubGlobal('fetch', mockFetch);\n\n      const result = await health.checkFunctionsHealth();\n\n      expect(result.status).toBe('error');\n      expect(result.error).toContain('Unexpected response');\n    });\n\n    it('resuelve error con network error', async () => {\n      const mockFetch = vi.fn().mockRejectedValue(new Error('ECONNREFUSED'));\n      vi.stubGlobal('fetch', mockFetch);\n\n      const result = await health.checkFunctionsHealth();\n\n      expect(result.status).toBe('error');\n      expect(result.error).toBe('ECONNREFUSED');\n    });\n\n    it('resuelve error con timeout (AbortError)', async () => {\n      const abortError = new Error('The operation was aborted');\n      abortError.name = 'AbortError';\n      const mockFetch = vi.fn().mockRejectedValue(abortError);\n      vi.stubGlobal('fetch', mockFetch);\n\n      const result = await health.checkFunctionsHealth();\n\n      expect(result.status).toBe('error');\n      expect(result.error).toBe('Timeout');\n      expect(result.latencyMs).toBe(5000);\n    });\n\n    it('calcula latencyMs correctamente', async () => {\n      const mockFetch = vi.fn().mockImplementation(\n        () =>\n          new Promise((resolve) =>\n            setTimeout(\n              () => resolve(makeResponse()),\n              10, // 10ms de retraso simulado\n            ),\n          ),\n      );\n      vi.stubGlobal('fetch', mockFetch);\n\n      const result = await health.checkFunctionsHealth();\n\n      // CI runners can be faster than 10ms, use 5ms threshold\n      expect(result.latencyMs).toBeGreaterThanOrEqual(5);\n      expect(result.latencyMs).toBeLessThan(100);\n    });\n  });\n\n  describe('getHealth', () => {\n    const makeResponse = (\n      overrides: Partial<{\n        ok: boolean;\n        status: number;\n        json: unknown;\n      }> = {},\n    ) => ({\n      ok: overrides.ok ?? true,\n      status: overrides.status ?? 200,\n      json: vi.fn().mockResolvedValue(overrides.json ?? { status: 'ok', service: 'functions' }),\n    });\n\n    it('retorna overall ok y status 200 cuando functions ok', async () => {\n      const mockFetch = vi.fn().mockResolvedValue(makeResponse());\n      vi.stubGlobal('fetch', mockFetch);\n\n      const { body, status } = await health.getHealth();\n\n      expect(body.bff).toEqual(health.BFF_HEALTH);\n      expect(body.functions.status).toBe('ok');\n      expect(body.overall).toBe('ok');\n      expect(status).toBe(200);\n    });\n\n    it('retorna overall degraded y status 503 cuando functions error', async () => {\n      const mockFetch = vi.fn().mockResolvedValue(makeResponse({ ok: false, status: 503 }));\n      vi.stubGlobal('fetch', mockFetch);\n\n      const { body, status } = await health.getHealth();\n\n      expect(body.bff).toEqual(health.BFF_HEALTH);\n      expect(body.functions.status).toBe('error');\n      expect(body.overall).toBe('degraded');\n      expect(status).toBe(503);\n    });\n\n    it('bff siempre ok', async () => {\n      const mockFetch = vi.fn().mockResolvedValue(makeResponse({ ok: false, status: 500 }));\n      vi.stubGlobal('fetch', mockFetch);\n\n      const { body } = await health.getHealth();\n\n      expect(body.bff).toEqual({ status: 'ok', service: 'bff' });\n    });\n  });\n});\n","usedDeprecatedRules":[]},{"filePath":"/home/diego/Documentos/jf-propiedad-raiz-web/packages/client/src/server/health.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/home/diego/Documentos/jf-propiedad-raiz-web/packages/client/src/server/match-route.test.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/home/diego/Documentos/jf-propiedad-raiz-web/packages/client/src/server/match-route.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/home/diego/Documentos/jf-propiedad-raiz-web/packag