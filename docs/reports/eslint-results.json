cale } from '@/i18n/config';\n\ninterface LanguageSwitcherProps {\n  readonly locale: Locale;\n  readonly className?: string | undefined;\n  readonly 'aria-label'?: string | undefined;\n}\n\nfunction LanguageSwitcherFallback({ targetLocale }: { targetLocale: Locale }) {\n  return (\n    <span className=\"opacity-50\" aria-hidden=\"true\">\n      🌐\n    </span>\n  );\n}\n\nfunction LanguageSwitcherInner({ locale, className, 'aria-label': ariaLabel }: LanguageSwitcherProps) {\n  const t = useTranslations('localeSwitcher');\n  const pathname = usePathname();\n  const searchParams = useSearchParams();\n  const search = searchParams?.toString() ? `?${searchParams.toString()}` : '';\n  const targetLocale = locale === 'es' ? 'en' : 'es';\n\n  return (\n    <Link\n      href={getEquivalentPath(pathname, search, targetLocale)}\n      className={className ?? ''}\n      aria-label={ariaLabel ?? t('switchTo')}\n    >\n      <span className=\"inline-block\" aria-hidden=\"true\">\n        🌐\n      </span>\n      <span>{t('switchTo')}</span>\n    </Link>\n  );\n}\n\nexport function LanguageSwitcher({ locale, className, 'aria-label': ariaLabel }: LanguageSwitcherProps) {\n  const targetLocale = locale === 'es' ? 'en' : 'es';\n\n  return (\n    <Suspense fallback={<LanguageSwitcherFallback targetLocale={targetLocale} />}>\n      <LanguageSwitcherInner locale={locale} className={className} aria-label={ariaLabel} />\n    </Suspense>\n  );\n}","usedDeprecatedRules":[]},{"filePath":"/home/diego/Documentos/jf-propiedad-raiz-web/packages/client/src/components/MobileMenu.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/home/diego/Documentos/jf-propiedad-raiz-web/packages/client/src/components/Navbar.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":