# Template only — NEVER put real secrets in this file.
# Copy to `.env.local` (root) if you need variables for tooling that runs from
# the repository root. Next.js and the Functions emulator do NOT read this file;
# they read the per-package files documented below.
#
# Canonical local-dev locations:
#   packages/client/.env.local    -> Next.js (BFF secrets + NEXT_PUBLIC_* emulator hosts)
#   packages/functions/.env       -> Functions emulator (BFF_INTERNAL_KEY, R2, translator)
#
# BFF_INTERNAL_KEY must be identical in both files. Generate one with:
#   openssl rand -hex 32
#
# See docs/EMULATORS.md §"Variables de entorno".

BFF_INTERNAL_KEY=
SESSION_JWT_SECRET=
FIREBASE_PROJECT_ID=jf-propiedad-raiz
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
FUNCTIONS_EMULATOR_HOST=localhost:5001
NEXT_PUBLIC_SITE_URL=http://localhost:3001
TRANSLATOR_FAKE=1
